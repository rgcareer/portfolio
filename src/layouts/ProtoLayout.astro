---
// Standalone layout for the B1 /proto moving mockup. Deliberately does NOT use
// BaseLayout: that carries the dark v3 chrome (cursor, HUD, wipe, WebGL) and
// motion.ts, and has no <head> slot for a robots meta or new font preloads.
// noindex + unlinked from nav: this is a gate artifact, not a shipped page.
import { ClientRouter } from 'astro:transitions';
import '../styles/proto.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'The Shelf (proto)', description = 'Moving mockup for the getsmartai.ai revamp.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- no-FOUC + reduced flag, before first paint -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (new URLSearchParams(location.search).has('reduce')) d.setAttribute('data-reduce', '');
        } catch (e) {}
      })();
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F7F8FA" />
    <link rel="preload" href="/fonts/source-serif4-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><style>#proto-curtain { display: none !important; } [data-in], [data-hero-in] { opacity: 1 !important; }</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script>import '../scripts/proto.ts';</script>
  </body>
</html>
