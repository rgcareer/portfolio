---
import ProtoLayout from '../layouts/ProtoLayout.astro';
import { objects } from './proto/_data';

const lane = 'Evaluation & trust';
---
<ProtoLayout title="The Shelf (proto)">
  <!-- composed opening: showroom curtain masking real font + poster decode -->
  <div id="proto-curtain" aria-hidden="true">
    <div class="curtain__inner">
      <div class="curtain__mark">Ryan Garver</div>
      <div class="curtain__rule" id="curtain-rule"></div>
      <div class="curtain__note">Setting the shelves</div>
    </div>
  </div>

  <a href="#after-shelf" class="skip-shelf">Skip this shelf</a>

  <main id="top">
    <!-- hero: editorial statement over the first shelf edge -->
    <header class="hero wrap">
      <h1 class="hero__display" data-hero-in>Everything I have built, with the numbers on the plaque.</h1>
      <p class="hero__body" data-hero-in>
        I help teams adopt AI, and I build a lot of it myself. Each object on these shelves is a real
        tool with real results.
      </p>
      <div class="hero__cta" data-hero-in>
        <a class="btn btn--primary" href="#shelf">Walk the shelves</a>
        <a class="btn btn--quiet" href="/resume" data-astro-reload>Read the resume</a>
      </div>
    </header>

    <!-- the one shelf (3 objects, pans horizontally on scroll >=861px + motion) -->
    <section class="shelf" id="shelf" aria-labelledby="lane-1">
      <div class="shelf__pin" id="shelf-pin">
        <div class="shelf__spotlight" id="shelf-spotlight" aria-hidden="true"></div>
        <div class="shelf__track" id="shelf-track">
          <div class="shelf__intro">
            <h2 class="shelf__lane" id="lane-1">{lane}</h2>
            <p class="shelf__lanebody">
              Tools that check the work: what is real, what is worth automating, and whether a
              model's output is good enough to ship.
            </p>
            <p class="shelf__hint" aria-hidden="true">Scroll to walk the shelf</p>
          </div>
          {objects.map((o) => (
            <article
              class:list={['object', o.tier === 'flagship' ? 'object--flagship' : 'object--standard']}
              data-chip={o.chip}
              data-slug={o.slug}
              data-in
              aria-labelledby={`t-${o.slug}`}
            >
              <div class="object__body">
              <div class="object__frame" transition:name={`frame-${o.slug}`}>
                <span class="object__chip" aria-hidden="true"></span>
                <img src={o.figure.src} alt={o.figure.alt} width={o.figure.width} height={o.figure.height} loading="eager" decoding="async" />
              </div>

              <div class="plaque">
                <h3 class="plaque__title" id={`t-${o.slug}`} data-engrave>{o.title}</h3>
                <p class="plaque__meta">{o.role} &middot; {o.year} &middot; {o.status}</p>

                <ul class="plaque__metrics">
                  {o.metrics.map((m) => (
                    <li class="plaque__metric">
                      <span class="plaque__label">{m.label}</span>
                      <span class="plaque__value">{m.value}</span>
                    </li>
                  ))}
                </ul>

                <div class="flip" data-flip>
                  <div class="flip__stage">
                    <div class="flip__inner">
                      <div class="flip__face flip__face--front">
                        <span class="flip__facelabel">The default way</span>
                        <p class="flip__facetext">{o.flip.before}</p>
                      </div>
                      <div class="flip__face flip__face--back">
                        <span class="flip__facelabel">The built way</span>
                        <p class="flip__facetext">{o.flip.after}</p>
                      </div>
                    </div>
                  </div>
                  <button class="flip__toggle" type="button" aria-pressed="false" aria-label={`Flip the ${o.title} plaque between the default way and the built way`}>Flip</button>
                </div>

                {o.caseHref && (
                  <a class="plaque__caselink" href={o.caseHref}>Case study</a>
                )}
              </div>
              </div>
            </article>
          ))}
          <div class="shelf__tail" aria-hidden="true"></div>
        </div>
        <div class="shelf__face" aria-hidden="true"></div>
        <div class="shelf__progress" id="shelf-progress" aria-hidden="true"></div>
      </div>
    </section>

    <div id="after-shelf"></div>

    <footer class="proto-footer wrap">
      <p class="proto-footer__note">Proto: motion gate for The Shelf. Not indexed, not linked.</p>
      <button class="sound-toggle" type="button" id="sound-toggle" aria-pressed="false">
        <span class="sound-toggle__dot" aria-hidden="true"></span>
        <span id="sound-label">Sound off</span>
      </button>
    </footer>
  </main>

  <!-- proto-only dial panel (tuning affordance; stripped at B2) -->
  <div class="dials" id="dials">
    <button class="dials__toggle" type="button" id="dials-toggle" aria-expanded="false" aria-controls="dials-panel">Dials</button>
    <div class="dials__panel" id="dials-panel" hidden>
      <div class="dial">
        <div class="dial__row"><span class="dial__name">Pan length</span><span class="dial__val" id="v-pan">2.4x</span></div>
        <input type="range" id="d-pan" min="1.5" max="4" step="0.1" value="2.4" />
      </div>
      <div class="dial">
        <div class="dial__row"><span class="dial__name">Spring strength</span><span class="dial__val" id="v-spring">1.70</span></div>
        <input type="range" id="d-spring" min="1" max="3" step="0.05" value="1.7" />
      </div>
      <div class="dial">
        <div class="dial__row"><span class="dial__name">Stagger</span><span class="dial__val" id="v-stagger">90ms</span></div>
        <input type="range" id="d-stagger" min="40" max="160" step="5" value="90" />
      </div>
      <div class="dial">
        <div class="dial__row"><span class="dial__name">Light intensity</span><span class="dial__val" id="v-light">0.50</span></div>
        <input type="range" id="d-light" min="0" max="1" step="0.05" value="0.5" />
      </div>
      <button class="dials__reset" type="button" id="dials-reset">Reset to defaults</button>
    </div>
  </div>
</ProtoLayout>
