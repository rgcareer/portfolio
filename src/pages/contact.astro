---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const title = 'Contact';
const description =
  'Tell me what is slow in your business and I will tell you what it costs to fix. Three fields, no sales call. Get Smart AI, Boise, led by Ryan Garver.';
---
<BaseLayout title={title} description={description} active="contact">
  <section class="close-cta" aria-labelledby="c-h">
    <div class="wrap">
      <p class="kicker" data-in>Start the conversation</p>
      <h2 class="sec-title" id="c-h" data-in>Tell me what is slow.</h2>
      <p class="close-sub" data-in>I will tell you what it costs to fix. You decide if the diagnostic was worth it; if not, the invoice is voided. And the $750 comes off any build you start within 90 days.</p>

      <form class="form" name="intake" data-intake data-in>
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
          <span class="err" role="alert">Add your name so I know who I am talking to.</span>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
          <span class="err" role="alert">Add an email I can reply to.</span>
        </div>
        <div class="field">
          <label for="f-slow">What is slow, in one line? <span class="opt">(optional)</span></label>
          <input id="f-slow" name="slow" type="text" maxlength="160" />
        </div>
        <div class="form-actions">
          <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent('What is slow in my business')}`} data-intake-submit data-magnetic>Send it to me <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
          <span class="form-note">Goes straight to me. No list, no sales sequence.</span>
        </div>
      </form>

      <p class="contact-alt" data-in>Prefer to reach out directly? Email <a class="link-green" href={`mailto:${site.email}`}>{site.email}</a><button type="button" class="copy-email" data-copy={site.email} aria-label={`Copy email address, ${site.email}`}>Copy</button> or find me on <a class="link-green" href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>.</p>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-alt { margin-top: 34px; color: var(--ink-2); font-size: var(--fs-small); max-width: 56ch; }
  .copy-email {
    display: none; /* revealed by motion.ts only when the clipboard API is available */
    margin-left: 8px; padding: 2px 9px; border-radius: 999px;
    font-family: var(--font-slab); font-size: 12px; font-weight: 600; line-height: 1.4;
    color: var(--burgundy); background: transparent; border: 1px solid var(--dot); cursor: pointer;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .copy-email.copy-enabled { display: inline-flex; align-items: center; }
  .copy-email:hover { border-color: var(--burgundy); }
  .copy-email:focus-visible { outline: 2px solid var(--burgundy); outline-offset: 2px; }
</style>
