---
// The real HOME, Green Light. Five beats ported from the approved /proto2 mockup
// (commit d5d26cc): annotation-pass hero -> services teaser (published prices) ->
// full-bleed green proof band -> annotated casebook teaser -> inline intake close.
// Numbers live INSIDE sentences, never in stat cards. No em/en dashes anywhere.
// Casebook pulls the flagship from work.ts (single source of truth). The intake
// form is styled markup ONLY (no backend): the Worker POST is wired at B3'.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getCase } from '../config/work';

const casebook = getCase('should-i-automate-this')!;

// Published service lines + prices (Ryan approved shipping the mockup rates, 2026-09-12).
const services = [
  { name: 'AI consulting', what: 'Find the', mark: 'follow-up leaks', tail: ' that cost you jobs.', price: 'from $750' },
  { name: 'Automation builds', what: 'Hand the repetitive work to', mark: 'something tireless', tail: '.', price: 'from $2,000' },
  { name: 'Website design', what: 'A site that', mark: 'earns its keep', tail: ', live in two weeks.', price: 'from $1,500' },
  { name: 'Team training', what: 'Your team,', mark: 'fluent in the tools', tail: ' they already pay for.', price: 'from $900' },
  { name: 'AI kits', what: 'The follow-up system,', mark: 'boxed and done for you', tail: '.', price: '$199' },
];

const homeDesc = 'AI that pays for itself, in plain English. Get Smart AI, led by Ryan Garver: AI consulting, automation, websites, and team training. Boise and remote.';

// Business surface -> ProfessionalService/LocalBusiness (service-area, no public street address).
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Get Smart AI',
  legalName: site.legalEntity,
  description: 'AI enablement and adoption for small businesses: consulting, automation builds, website design, and team training.',
  url: site.url,
  email: `mailto:${site.email}`,
  areaServed: 'Boise, Idaho and remote',
  founder: { '@type': 'Person', name: site.name },
  sameAs: [site.links.linkedin, site.links.github],
};
---
<BaseLayout description={homeDesc} jsonLd={businessLd}>
  <!-- BEAT 1: annotation-pass entrance -->
  <section class="wrap hero" aria-label="Introduction">
    <p class="eyebrow" data-hero-in>Get Smart AI · Boise, ID and remote</p>
    <h1 data-hero-in style="--in-delay: 70ms">
      AI that <span class="usweep" data-sweep>pays for itself</span>, in <span class="usweep" data-sweep>plain English</span>.
    </h1>
    <p class="lead" data-hero-in style="--in-delay: 150ms">
      I build it, I teach it, and every claim on this site is one I can show you.
    </p>
    <div class="cta-row" data-hero-in style="--in-delay: 230ms">
      <a class="btn" href="#close">Start with a plain-English audit</a>
      <a class="link-quiet" href="#casebook">See the work</a>
    </div>
  </section>

  <!-- BEAT 2: services teaser -->
  <section class="wrap section" id="services" aria-labelledby="svc-h">
    <div class="svc-head">
      <p class="eyebrow" data-in>One practice, five ways in</p>
      <h2 id="svc-h" data-in style="--in-delay: 60ms">Pick the format. The <span class="gw">promise stays the same</span>.</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <div class="svc" data-in style={`--in-delay: ${i * 60}ms`}>
          <div class="svc__name">{s.name}</div>
          <div class="svc__what">{s.what} <span class="gw">{s.mark}</span>{s.tail}</div>
          <div class="svc__price">{s.price}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- BEAT 3: pine proof band -->
  <section class="band" aria-label="Proof">
    <div class="wrap">
      <p class="eyebrow" data-in>Proof, not adjectives</p>
      <p class="claim" data-in style="--in-delay: 80ms">
        I built a scorer that read <span class="mark num" data-sweep>14,851</span> job postings,
        checked each against its source, and made <span class="mark num" data-sweep>zero</span> re-score errors.
      </p>
      <p class="attrib" data-in style="--in-delay: 160ms">Operation Hired · a tool I built, 616 tests passing</p>
    </div>
  </section>

  <!-- BEAT 4: annotated casebook spread -->
  <section class="wrap section" id="casebook" aria-labelledby="case-h">
    <div class="case">
      <div class="case__body">
        <p class="case__kick" data-in>Case · {casebook.role} · {casebook.year}</p>
        <h2 class="case__title" id="case-h" data-in style="--in-delay: 50ms">{casebook.title}</h2>
        <p class="case__lead" data-in style="--in-delay: 110ms">
          It ships with <span class="mark" data-sweep>28 of 28 tests</span> passing and
          <span class="mark" data-sweep>10 of 10</span> calibration goldens, and it answers one question:
          should a model touch this task at all?
        </p>
        <div class="case__ba">
          <div class="ba__row" data-in>
            <div class="ba__tag">The default way</div>
            <div class="ba__txt">{casebook.flip?.before}</div>
          </div>
          <div class="ba__row" data-in style="--in-delay: 70ms">
            <div class="ba__tag is-built">The built way</div>
            <div class="ba__txt is-built">{casebook.flip?.after}</div>
          </div>
        </div>
        <p class="verdict" data-in style="--in-delay: 60ms">
          It talks you out of the <span class="gw">wrong ones first</span>.
        </p>
        <a class="link-green case__more" href="/work/should-i-automate-this" data-in>Read the case</a>
      </div>
      <figure class="case__fig" data-in style="--in-delay: 120ms">
        <div class="frame">
          <img src={casebook.figure.src} alt={casebook.figure.alt} width={casebook.figure.width} height={casebook.figure.height} loading="lazy" />
        </div>
        <figcaption>The verdict screen: a tier and a concrete stop-test, not a hype score.</figcaption>
      </figure>
    </div>
  </section>

  <!-- BEAT 5: intake close (markup only; Worker POST wired at B3') -->
  <section class="close" id="close" aria-labelledby="close-h">
    <div class="wrap section">
      <h2 id="close-h" data-in>Tell me what is slow. I will tell you if <span class="gw">AI actually fixes it</span>.</h2>
      <p class="sub" data-in style="--in-delay: 70ms">
        No sales call. A short note, and a straight answer about whether this is worth your money.
      </p>
      <form class="intake" data-in style="--in-delay: 140ms" aria-label="Start a conversation">
        <input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="Your name" />
        <input type="email" name="email" placeholder="Email" autocomplete="email" aria-label="Email" />
        <button class="btn" type="button">Start the conversation</button>
      </form>
      <p class="fine" data-in style="--in-delay: 200ms">Prefer email? <a href={`mailto:${site.email}`}>Write me directly.</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* BEAT 1 hero */
  .hero { min-height: 92svh; display: flex; flex-direction: column; justify-content: center; padding-block: var(--space-16) var(--space-24); }
  .hero h1 { font-size: var(--fs-display); font-weight: 720; max-width: 15ch; margin-block: var(--space-6) 0; }
  .hero .lead { font-size: var(--fs-lead); color: var(--ink-soft); max-width: 46ch; margin-top: var(--space-8); }
  .hero .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); align-items: center; margin-top: var(--space-12); }

  /* BEAT 2 services */
  .svc-head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-16); }
  .svc-head h2 { font-size: var(--fs-h1); font-weight: 660; max-width: 20ch; }
  .svc-list { border-top: 1px solid var(--line); }
  .svc { display: grid; grid-template-columns: minmax(9rem, 15rem) 1fr auto; gap: var(--space-4) var(--space-8); align-items: baseline; padding-block: var(--space-8); border-bottom: 1px solid var(--line); }
  .svc__name { font-family: var(--display); font-size: 1.24rem; font-weight: 640; letter-spacing: -0.01em; }
  .svc__what { font-size: 1.12rem; color: var(--ink-soft); }
  .svc__price { font-family: var(--sans); font-weight: 580; font-size: 1.02rem; color: var(--ink); white-space: nowrap; }

  /* BEAT 3 pine proof band */
  .band { background: var(--band-bg); color: var(--band-ink); position: relative; }
  .band .wrap { padding-block: clamp(var(--space-24), 13vw, 160px); }
  .band .eyebrow { color: var(--band-muted); }
  .band p.claim { font-family: var(--display); font-size: clamp(1.9rem, 4.3vw, 3.4rem); line-height: 1.18; font-weight: 640; max-width: 20ch; margin-top: var(--space-6); color: var(--band-ink); letter-spacing: -0.02em; }
  .band .num { font-size: 1.14em; font-weight: 780; }
  .band .attrib { font-family: var(--sans); font-size: var(--fs-small); color: var(--band-muted); margin-top: var(--space-8); letter-spacing: 0.02em; }

  /* BEAT 4 casebook spread */
  .case { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(var(--space-8), 5vw, var(--space-24)); align-items: start; }
  .case__kick { font-family: var(--sans); font-size: var(--fs-small); font-weight: 560; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }
  .case__title { font-size: var(--fs-h1); font-weight: 660; margin-top: var(--space-3); }
  .case__lead { font-size: var(--fs-lead); color: var(--ink-soft); margin-top: var(--space-6); }
  .case__ba { display: grid; gap: var(--space-6); margin-top: var(--space-12); }
  .ba__row { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: baseline; }
  .ba__tag { font-family: var(--sans); font-size: 0.78rem; font-weight: 580; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; padding-top: 0.25em; }
  .ba__tag.is-built { color: var(--action-ink); }
  .ba__txt { font-size: 1.1rem; color: var(--ink-soft); }
  .ba__txt.is-built { color: var(--ink); }
  .verdict { font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 640; line-height: 1.22; margin-top: var(--space-12); max-width: 22ch; letter-spacing: -0.015em; }
  .case__more { margin-top: var(--space-8); display: inline-block; }
  .case__fig { margin: 0; }
  .case__fig .frame { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--space-3); box-shadow: 0 1px 2px rgba(20,22,20,.05), 0 22px 48px rgba(20,30,24,.10); overflow: hidden; }
  .case__fig img { border-radius: 6px; width: 100%; height: auto; }
  .case__fig figcaption { font-family: var(--sans); font-size: 0.82rem; color: var(--ink-muted); margin-top: var(--space-3); }

  /* BEAT 5 intake close */
  .close { background: var(--stone-2); }
  .close h2 { font-size: var(--fs-h1); font-weight: 660; max-width: 18ch; }
  .close .sub { font-size: var(--fs-lead); color: var(--ink-soft); margin-top: var(--space-6); max-width: 42ch; }
  .intake { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-12); max-width: 32rem; }
  .intake input { flex: 1 1 15rem; min-width: 0; font: inherit; font-size: 1.02rem; padding: 0.85em 1em; border: 1.5px solid var(--line-strong); border-radius: 999px; background: var(--paper); color: var(--ink); }
  .intake input::placeholder { color: var(--ink-muted); }
  .intake input:focus-visible { border-color: var(--action-ink); outline: none; }
  .intake .btn { flex: 0 0 auto; }
  .close .fine { font-family: var(--sans); font-size: var(--fs-small); color: var(--ink-muted); margin-top: var(--space-6); }
  .close .fine a { color: var(--action-ink); }

  @media (max-width: 820px) {
    .case { grid-template-columns: 1fr; }
    .case__fig { order: -1; max-width: 24rem; }
    .svc { grid-template-columns: 1fr auto; }
    .svc__what { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 88svh; }
    .hero h1 { font-size: clamp(2.5rem, 12vw, 3.4rem); }
    .svc { grid-template-columns: 1fr; gap: var(--space-2); }
    .svc__price { justify-self: start; }
    .intake input { flex-basis: 100%; }
    .intake .btn { width: 100%; justify-content: center; }
  }
</style>
