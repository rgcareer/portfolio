---
import BaseLayout from './BaseLayout.astro';
import { getCase, work } from '../config/work';
import { site } from '../config/site';

interface Props { slug: string; }
const { slug } = Astro.props;
const c = getCase(slug)!;
const idx = work.findIndex((w) => w.slug === slug);
const next = work[(idx + 1) % work.length];
---

<BaseLayout title={c.title} active="work" description={c.tagline}>
  <article class="cs container">
    <a href="/work" class="cs__back reveal">Back to work</a>

    <header class="cs__head reveal">
      <p class="cs__kicker">{c.role} · {c.year} · {c.status}</p>
      <h1 class="cs__title">{c.title}</h1>
      <p class="cs__tagline">{c.tagline}</p>
      {c.links && (
        <div class="cs__links">
          {c.links.map((l) => (
            <a class="link-chip" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </div>
      )}
    </header>

    <div class="cs__layout">
      <aside class="cs__rail reveal">
        <dl class="cs__meta">
          <div><dt>Role</dt><dd>{c.role}</dd></div>
          <div><dt>Status</dt><dd>{c.status}</dd></div>
          <div><dt>Stack</dt><dd>{c.stack.join(' · ')}</dd></div>
        </dl>
      </aside>

      <div class="cs__main">
        <div class="cs__metrics reveal">
          {c.metrics.map((m) => (
            <div class="cs__metric">
              <span class="cs__metric-v">{m.value}</span>
              <span class="cs__metric-l">{m.label}</span>
              {m.note && <span class="cs__metric-n">{m.note}</span>}
            </div>
          ))}
        </div>

        <figure class="cs__fig reveal">
          <div class="cs__frame">
            {c.figure.src ? (
              <img src={c.figure.src} alt={c.figure.alt ?? ''} width={c.figure.width} height={c.figure.height} loading="eager" decoding="async" />
            ) : (
              <pre class="cs__specimen">{c.figure.specimen?.join('\n')}</pre>
            )}
          </div>
          <figcaption>{c.figure.caption}</figcaption>
        </figure>

        <div class="cs__body prose">
          <slot />
        </div>

        <nav class="cs__next" aria-label="Next case study">
          <a href={`/work/${next.slug}`} class="cs__next-card">
            <span class="cs__next-k">Next project</span>
            <span class="cs__next-t">{next.title}</span>
          </a>
          <a href={`mailto:${site.careerEmail}`} class="btn cs__next-cta" data-magnetic>Get in touch <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cs { padding-top: clamp(2.4rem, 5vw, 3.4rem); padding-bottom: clamp(4rem, 9vw, 7rem); }

  .cs__back {
    display: inline-block; font-family: var(--font-slab); font-size: var(--fs-small); font-weight: 500;
    color: var(--muted); text-decoration: none; border-bottom: 1.5px solid var(--dot); padding-bottom: 2px;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .cs__back::before { content: '\2190'; margin-right: 8px; color: var(--burgundy); }
  .cs__back:hover { color: var(--burgundy); border-color: var(--burgundy); }

  .cs__head { margin-top: 1.8rem; border-bottom: 2px solid var(--ink); padding-bottom: clamp(1.4rem, 4vw, 2.2rem); }
  .cs__kicker {
    font-family: var(--font-slab); font-size: var(--fs-kicker); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--burgundy);
  }
  .cs__title { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; line-height: 1.05; margin-top: 0.7rem; text-wrap: balance; }
  .cs__tagline { font-size: var(--fs-lead); color: var(--ink-2); margin-top: 1rem; max-width: 48ch; }
  .cs__links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }

  .cs__layout { display: grid; gap: clamp(2rem, 5vw, 3.6rem); margin-top: clamp(1.8rem, 4vw, 2.6rem); }
  @media (min-width: 900px) {
    .cs__layout { grid-template-columns: 220px minmax(0, 1fr); align-items: start; }
    .cs__rail { position: sticky; top: 6rem; }
  }
  .cs__main { min-width: 0; }

  .cs__meta { display: flex; flex-wrap: wrap; gap: 1.2rem 2.2rem; }
  @media (min-width: 900px) { .cs__meta { flex-direction: column; gap: 1.3rem; } }
  .cs__meta dt {
    font-family: var(--font-slab); font-size: var(--fs-caption); text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--burgundy); font-weight: 600; margin-bottom: 0.35rem;
  }
  .cs__meta dd { font-size: var(--fs-small); color: var(--ink-2); max-width: 24ch; }

  /* metrics as a ledger strip (rules, not filled cards) */
  .cs__metrics {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink); border-bottom: 1px solid var(--hairline);
  }
  .cs__metric { padding: 1.1rem 1.2rem 1.1rem 0; border-right: 1px solid var(--hairline); }
  .cs__metric:last-child { border-right: 0; }
  .cs__metric-v {
    display: block; font-family: var(--font-slab); font-weight: 700; font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    color: var(--burgundy); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; line-height: 1.1;
  }
  .cs__metric-l {
    display: block; font-family: var(--font-display); font-size: var(--fs-caption); text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); margin-top: 0.45rem;
  }
  .cs__metric-n {
    display: block; font-family: var(--font-slab); font-size: var(--fs-caption);
    color: var(--muted); margin-top: 0.4rem; max-width: 28ch; line-height: 1.4; text-wrap: pretty;
  }
  @media (max-width: 600px) {
    .cs__metrics { grid-template-columns: 1fr; border-bottom: 0; }
    .cs__metric { border-right: 0; border-bottom: 1px solid var(--hairline); padding-right: 0; }
  }

  /* figure: hairline frame, no shadow, no fake browser chrome (Open Book) */
  .cs__fig { margin-top: 1.8rem; }
  .cs__frame { border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; background: var(--blush); }
  .cs__frame img { width: 100%; height: auto; display: block; }
  .cs__specimen {
    font-family: var(--font-mono); font-size: clamp(0.68rem, 1.4vw, 0.82rem); line-height: 2;
    color: var(--ink-2); margin: 0; padding: 1.4rem 1.6rem; white-space: pre; overflow-x: auto;
  }
  .cs__fig figcaption {
    font-family: var(--font-slab); font-size: var(--fs-caption); color: var(--muted);
    letter-spacing: 0.01em; padding: 0.9rem 0.2rem 0; max-width: 62ch; line-height: 1.5;
  }

  .cs__body { max-width: 720px; margin-top: clamp(2.4rem, 5vw, 3.4rem); }

  .cs__next {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; justify-content: space-between;
    margin-top: clamp(3.5rem, 8vw, 6rem); padding-top: 2rem; border-top: 1px solid var(--hairline);
  }
  .cs__next-card {
    flex: 1 1 260px; text-decoration: none; color: inherit;
    border-left: 2px solid var(--dot); padding: 0.4rem 0 0.4rem 1rem;
    transition: border-color var(--dur-fast) ease;
  }
  .cs__next-card:hover { border-color: var(--burgundy); }
  .cs__next-k {
    font-family: var(--font-slab); font-size: var(--fs-kicker); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--burgundy);
  }
  .cs__next-t { display: block; font-size: var(--fs-lead); font-weight: 600; margin-top: 0.35rem; color: var(--ink); }
  .cs__next-card:hover .cs__next-t { color: var(--burgundy); }
</style>
