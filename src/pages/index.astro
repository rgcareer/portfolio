---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { offers, offerCopy, continuity, dataHandling, kit } from '../config/offers';

// FAQ = one source, rendered visibly AND as FAQPage schema (must match; 2026 spam filter).
const faqs = [
  {
    q: 'How much does this cost?',
    a: 'Every price is on this page. The diagnostic is a flat $750. Automation builds start at $2,000, team training at $900, and the full enablement program at $2,500, all fixed in writing after the diagnostic scopes the work. Keeping it running is $0 a month, because you own it. There is a $199 starter kit under the rate card, and websites have their own page. Nothing is hidden behind a call.',
  },
  {
    q: 'Do I need to understand AI to work with you?',
    a: 'No. My whole job is to make AI make sense and make money for people who do not care how it works. I speak plain English and I put the numbers where you can see them.',
  },
  {
    q: 'How are you different from a $95 automation gig online?',
    a: 'A gig builds the one thing you already know you want. I start by finding what is actually costing you money, then build and stand behind the fix. You get a named person who diagnoses first, not a checkout cart.',
  },
  {
    q: 'Why not just use ChatGPT myself?',
    a: 'ChatGPT can draft the follow-up text. It cannot notice the missed call at 6:40 and send it for you. The gap between a smart chat window and a system wired into your phone, calendar, and CRM is the part I build.',
  },
  {
    q: 'What happens if you are not available later?',
    a: 'The code and logins live in your accounts, you get a written handoff, and there is a named backup. It costs $0 a month to keep running because you own it. No lock-in.',
  },
  {
    q: 'Which businesses do you work with?',
    a: 'Small businesses that run without an engineering department, in and around Boise and remote: trades, dental and medical practices, restaurants, retail, and professional services.',
  },
];

const homeLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#practice`,
    name: 'Get Smart AI',
    alternateName: 'Get Smart AI, led by Ryan Garver',
    description:
      'AI consulting, automation builds, team training, and websites for small businesses without an engineering department. Published prices, a named principal, and a diagnostic that is free if it is not worth the fee.',
    url: site.url,
    image: new URL('/og.png', site.url).toString(),
    areaServed: [
      { '@type': 'City', name: 'Boise' },
      { '@type': 'AdministrativeArea', name: 'Treasure Valley' },
      { '@type': 'Country', name: 'United States' },
    ],
    address: { '@type': 'PostalAddress', addressLocality: 'Boise', addressRegion: 'ID', addressCountry: 'US' },
    founder: { '@type': 'Person', name: site.name, jobTitle: site.role },
    knowsAbout: ['AI automation', 'AI consulting', 'business process automation', 'AI adoption', 'small business AI'],
    sameAs: [site.links.linkedin, site.links.github].filter(Boolean),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services and prices',
      itemListElement: [
        { name: 'AI diagnostic', price: 750 },
        { name: 'Automation build', price: 2000 },
        { name: 'Team training', price: 900 },
        { name: 'Enablement program', price: 2500 },
        { name: 'Website', price: 1500 },
        { name: 'Contractor AI Follow-Up Revenue Kit', price: 199 },
      ].map((o) => ({
        '@type': 'Offer',
        name: o.name,
        priceSpecification: { '@type': 'PriceSpecification', minPrice: o.price, priceCurrency: 'USD' },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const title = 'AI Automation & Consulting for Small Business, Boise';
const description =
  'Practical AI for Boise small businesses without an engineering department: automation, consulting, training, and websites. Published prices, a real named principal, and a diagnostic that is free if it is not worth the fee.';
---
<BaseLayout title={title} description={description} active="home" jsonLd={homeLd}>
  <div class="hero">
    <div class="sun-patch" aria-hidden="true"><canvas class="daylight" aria-hidden="true"></canvas></div>
    <div class="wrap">
      <p class="eyebrow" data-hero-step style="--step: 0">Get Smart AI · Boise and the Treasure Valley · led by <b>Ryan Garver</b></p>
      <h1>
        <span class="line"><span class="line-in" style="--line-step: 1">The call you miss at 6:40</span></span>
        <span class="line"><span class="line-in" style="--line-step: 2">is a job gone by 6:41.</span></span>
      </h1>
      <p class="hero-sub" data-hero-step style="--step: 3">A call comes in while you are on a roof. Nobody answers, and that customer calls the next company on the list. I build the system that catches the call and follows up, so the job does not walk.</p>
      <p class="hero-ledger" data-hero-step style="--step: 4">Every price here is published. Every number is real.</p>
      <div class="cta-row" data-hero-step style="--step: 5">
        <a class="btn" href="#start" data-magnetic>Start with a diagnostic <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="link-arrow" href="#rates">See the rate card <span class="a" aria-hidden="true">&rarr;</span></a>
      </div>
      <p class="hero-certainty" data-hero-step style="--step: 6">You will know by a set date what it costs to fix.</p>
    </div>
  </div>

  <section id="estimate" class="sec-blush" aria-labelledby="estimate-h">
    <div class="wrap">
      <p class="kicker" data-in>Your number</p>
      <h2 class="sec-title" id="estimate-h" data-in>What is a missed call actually costing you?</h2>
      <div class="estimator" data-estimator data-in>
        <p class="est-lead">Use your own numbers.</p>

        <p class="est-static" data-est-static>
          A worked example: miss 10 calls a week, an average job is worth $400, and you win 3 of every 10 good leads. That is about <b>$5,200 a month</b> walking to whoever answers first. Turn on scripts to run your own numbers.
        </p>

        <div class="est-live" data-est-live hidden>
          <div class="est-inputs">
            <div class="est-field">
              <label for="est-calls">Missed calls in a typical week</label>
              <input id="est-calls" type="number" inputmode="numeric" min="0" step="1" value="10" />
            </div>
            <div class="est-field">
              <label for="est-value">What an average job is worth to you</label>
              <input id="est-value" type="number" inputmode="numeric" min="0" step="50" value="400" />
            </div>
            <div class="est-field">
              <label for="est-real">Jobs you win out of ten good leads</label>
              <input id="est-real" type="number" inputmode="numeric" min="0" max="10" step="1" value="3" />
            </div>
          </div>
          <div class="est-out">
            <span class="est-figure" data-est-out aria-live="polite">$5,200</span>
            <span class="est-caption">a month, walking to whoever picks up first. Your numbers, multiplied. Nothing here is my estimate. Illustrative only; your results will vary.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="rates" aria-labelledby="rates-h">
    <div class="wrap">
      <p class="kicker" data-in>The rate card</p>
      <h2 class="sec-title" id="rates-h" data-in>What it costs, in plain sight</h2>
      <p class="sec-intro" data-in>Published rates, the way your accountant would insist on. Start with the diagnostic. Everything after it is scoped from what it finds.</p>

      <div class="ledger" data-in>
        {offers.map((o) => (
          <div class:list={['line-item', { 'is-start': o.startHere, 'is-flagship': o.flagship }]}>
            {o.startHere && <span class="li-flag">Start here</span>}
            {o.flagship && <span class="li-flag">The full program</span>}
            <div class="li-row">
              <span class="li-name">{o.name}</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="li-price">{o.startingAt && <small>Starting at</small>}{o.priceLabel}</span>
            </div>
            <p class="li-sub">{o.mechanism}</p>
            {o.startHere && (
              <>
                <p class="li-guarantee">{offerCopy.guaranteeFull}</p>
                <p class="li-sample">{offerCopy.sampleLine}</p>
              </>
            )}
          </div>
        ))}
      </div>
      <p class="ledger-basis" data-in>{offerCopy.pricingBasis}</p>
      <p class="ledger-basis" data-in>{offerCopy.floorsLow}</p>
      <p class="ledger-note" data-in>{kit.line}</p>
    </div>
  </section>

  <section id="compare" class="sec-blush" aria-labelledby="compare-h">
    <div class="wrap">
      <p class="kicker" data-in>The cheaper options, honestly</p>
      <h2 class="sec-title" id="compare-h" data-in>What the quick fixes leave you holding</h2>
      <div class="subs" data-in>
        <div class="panel">
          <h3>A chatbot</h3>
          <p>A chatbot can draft the follow-up text. It cannot notice the missed call and send it. That trigger is the whole job.</p>
        </div>
        <div class="panel">
          <h3>A freelancer gig</h3>
          <p>A freelancer builds the automation you already know you want. The diagnostic is for the owner who does not yet know which fix comes first.</p>
        </div>
        <div class="panel">
          <h3>An answering service</h3>
          <p>An answering service answers the phone. It does not fix what happens after: the quote that goes cold, the follow-up nobody sends.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="proof" id="proof" aria-labelledby="proof-h">
    <div class="wrap">
      <p class="kicker" data-in>The proof</p>
      <h2 class="sec-title" id="proof-h" data-in>I measure my own work. You can check it.</h2>
      <p class="sec-intro" data-in>I run a system in real production and keep the receipts. Here is how it holds up, ranked the way it actually matters.</p>

      <div class="totals" data-in>
        <div class="total">
          <div class="total-figure" data-count="0">0</div>
          <p class="total-label">re-score errors on the audited pass</p>
          <p class="total-bridge">Run it twice, get the same answer twice. That is the standard I hold my own system to, and the one I will hold yours to.</p>
        </div>
        <div class="total">
          <div class="total-figure" data-count="616">616</div>
          <p class="total-label">tests keeping the scoring honest</p>
          <p class="total-bridge">Before it touches real work, 616 separate checks have to pass. Your phone system gets the same discipline.</p>
        </div>
        <div class="total">
          <div class="total-figure" data-count="0" data-prefix="$">$0</div>
          <p class="total-label">extra cost to score one more</p>
          <p class="total-bridge">The ten-thousandth one costs the same as the first: nothing extra.</p>
        </div>
      </div>

      <p class="scope-context" data-in>That same system, Operation Hired, has scored <span class="num">14,851</span> job postings in total, each one reproducible from its source.</p>

      <p class="thesis-line" data-in>The point is not the size of the number. It is that <b>you can open the file and check it.</b></p>

      <div class="case-line" data-in>
        <p><strong>Operation Hired.</strong> Real production I designed, built, and ran myself, with real load and kept receipts. I will measure your business the same way.</p>
        <a class="link-arrow" href="/work/operation-hired/method">Method and results, open the file <span class="a" aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="slot-empty" data-in>
        Local client work is not published here yet. When it is, it will be a named business in your trade with real before and after numbers, not a logo wall. Until then, the system above is the receipt I can show you.
      </div>
    </div>
  </section>

  <section id="own" aria-labelledby="own-h">
    <div class="wrap">
      <p class="kicker" data-in>What you own afterward</p>
      <h2 class="sec-title" id="own-h" data-in>One person built it. You are not locked to one person.</h2>
      <p class="sec-intro" data-in>The honest answer to "what happens if you get hit by a bus," on the page, before you ask.</p>
      <div class="rows" data-in>
        {continuity.map((row) => (
          <div class="row-item">
            <span class="r-k">{row.k}</span>
            <span class="r-v">{row.v}</span>
          </div>
        ))}
      </div>
      <p class="notice" data-in><b>Your data stays yours.</b> {dataHandling}</p>
    </div>
  </section>

  <section id="faq" class="sec-blush" aria-labelledby="faq-h">
    <div class="wrap">
      <p class="kicker" data-in>Straight answers</p>
      <h2 class="sec-title" id="faq-h" data-in>The questions everyone asks first</h2>
      <div class="rows" data-in>
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="principal" aria-labelledby="principal-h">
    <div class="wrap">
      <p class="kicker" data-in>The principal</p>
      <h2 class="sec-title" id="principal-h" data-in>The person who answers is the person who builds it</h2>
      <p class="principal-body" data-in>I am Ryan Garver. I have spent twenty years in the Treasure Valley teaching non-technical teams to use new tools, at Apple, Intuit, Cradlepoint, and Vacasa. I run this practice to keep that work current and measurable.</p>
      <p class="principal-body" data-in>You are the expert on your business. I build the follow-up system. When I say a tool pays for itself, it is because I <span class="em">built it, ran it, and kept the receipts.</span></p>
      <p class="signature" data-in>Ryan Garver · Get Smart AI · Boise, Idaho</p>
    </div>
  </section>

  <section class="close-cta sec-blush" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <p class="kicker" data-in>The next line item</p>
      <h2 class="sec-title" id="start-h" data-in>Tell me what is slow.</h2>
      <p class="close-sub" data-in>I will tell you what it costs to fix. Three fields, no sales call. You decide if the diagnostic was worth it; if not, the invoice is voided.</p>

      <form class="form" name="intake" data-intake data-in>
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
          <span class="err" role="alert">Add your name so I know who I am talking to.</span>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
          <span class="err" role="alert">Add an email I can reply to.</span>
        </div>
        <div class="field">
          <label for="f-slow">What is slow, in one line?</label>
          <input id="f-slow" name="slow" type="text" maxlength="160" />
        </div>
        <div class="form-actions">
          <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent('What is slow in my business')}`} data-intake-submit data-magnetic>Start the conversation <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
          <span class="form-note">Goes straight to me. No list, no sales sequence.</span>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-ledger { margin-top: 18px; font-family: var(--font-slab); font-weight: 600; font-size: var(--fs-small); color: var(--burgundy); letter-spacing: 0.01em; }
  .hero-certainty { margin-top: 14px; font-size: var(--fs-small); color: var(--muted); }
  .line-item.is-flagship { border-top: 2px solid var(--burgundy); }
  .subs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 40px; margin-top: 30px; }
  @media (max-width: 800px) { .subs { grid-template-columns: 1fr; } }
  .faq { border-top: 1px solid var(--hairline); padding: 4px 0; }
  .faq:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; cursor: pointer; padding: 16px 28px 16px 0; font-weight: 600; font-size: 17px; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 2px; top: 14px; font-family: var(--font-slab); font-size: 22px; color: var(--burgundy); line-height: 1; }
  .faq[open] summary::after { content: '\2212'; }
  .faq p { padding: 0 0 18px; color: var(--ink-2); max-width: 64ch; }
</style>
