---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { offerCopy } from '../config/offers';

// The services hub (namespace decided 2026-09-15: services live under /consulting).
// This is the "how I work" page - the engagement and the honest-outsider posture -
// deliberately NOT a re-list of the home rate card (that stays the priced overview).
// Identity per charter §6.2 on /consulting: "Ryan" + Smart Business AI LLC. JSON-LD is
// the default Person (the home owns the single ProfessionalService entity, #practice).
const title = 'AI consulting and implementation for small business, Boise';
const description =
  'How I work: a $750 diagnostic that finds where work leaks out, a fixed-price build, and a system you own outright. AI automation, websites, and training for Boise small businesses. Led by Ryan.';

// The engagement, start to finish.
const steps = [
  {
    k: 'Start with the diagnostic',
    price: '$750',
    d: 'I spend a day inside your business and find the three places work leaks out: the call that went to voicemail, the quote stuck in drafts, the recall nobody sent. You get a written fix list with a price next to each line.',
  },
  {
    k: 'A scoped build, fixed in writing',
    price: 'from $2,000',
    d: 'You pick what to fix first. I build it, test it, and hand it over running in your own accounts, with the instructions. One fix or a full program, the price is agreed before I start.',
  },
  {
    k: 'You own it',
    price: '$0/mo',
    d: 'The code, the logins, and the documents live in your accounts. A written handoff and a named backup, so it does not depend on one person. Office hours are there if you want them, never required.',
  },
];

// What I can build (index; prices live on the home rate card, details on their pages).
const canBuild = [
  { k: 'Automation builds', d: 'The missed call at 6:40 gets a text back by 6:41. The report that eats your Friday builds itself overnight.', href: '/#rates' },
  { k: 'Websites', d: 'A site that answers the phone when you cannot: it books the job and sends the quote. This site is the sample.', href: '/consulting/web-design' },
  { k: 'Team training', d: 'A working session on your real tools, so your people leave using it on Monday, not holding a manual.', href: '/#rates' },
  { k: 'The enablement program', d: 'A 60 to 90 day arc: the builds from your list, live sessions, and the SOP and prompt library you keep.', href: '/#rates' },
];
---
<BaseLayout title={title} description={description} active="consulting">
  <section class="container cn">
    <header class="cn__head">
      <p class="kicker" data-in>How I work</p>
      <h1 class="cn__title" data-in>You are the expert on your business. I build the systems.</h1>
      <p class="cn__lead" data-in>
        I am Ryan. I spent twenty years teaching non-technical teams to use new tools, at Apple, Intuit,
        Cradlepoint, and Vacasa, all here in the Treasure Valley. I am not a contractor pretending to be
        one of the guys, and I am not an agency. I am the AI and operations person you would hire, who
        happens to work for himself. You know the trade. I find where it is leaking money and build the
        fix.
      </p>
    </header>

    <section class="cn-sec" aria-labelledby="how-h">
      <h2 class="sec-title" id="how-h" data-in>What an engagement looks like</h2>
      <div class="steps" data-in>
        {steps.map((s) => (
          <div class="step">
            <div class="step__row">
              <span class="step__k">{s.k}</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="step__price">{s.price}</span>
            </div>
            <p class="step__d">{s.d}</p>
          </div>
        ))}
      </div>
      <p class="cn__basis" data-in>{offerCopy.pricingBasis} {offerCopy.floorsLow}</p>
    </section>

    <section class="cn-sec sec-blush" aria-labelledby="build-h">
      <div class="wrap">
        <p class="kicker" data-in>What I can build</p>
        <h2 class="sec-title" id="build-h" data-in>The kinds of work, and where each one lives</h2>
        <div class="build" data-in>
          {canBuild.map((b) => (
            <a class="build__item" href={b.href}>
              <span class="build__k">{b.k} <span class="build__go" aria-hidden="true">&rarr;</span></span>
              <span class="build__d">{b.d}</span>
            </a>
          ))}
        </div>
        <p class="cn__note" data-in>Every price is published on the <a class="link-green" href="/#rates">rate card</a>, and the diagnostic guarantee is simple: {offerCopy.guaranteeShort}</p>
      </div>
    </section>

    <section class="cn-sec" aria-labelledby="proof-h">
      <p class="kicker" data-in>Proof</p>
      <h2 class="sec-title" id="proof-h" data-in>I measure my own work, and I will measure yours the same way.</h2>
      <p class="cn__lead" data-in>No client logos and no testimonials here yet. The proof is a system I built, ran, and kept the receipts on. You can open the file and check the numbers.</p>
      <div class="cn__links" data-in>
        <a class="link-arrow" href="/work">See the work <span class="a" aria-hidden="true">&rarr;</span></a>
        <a class="link-quiet" href="/about">More about the practice</a>
        <a class="link-quiet" href="/resume">Résumé</a>
      </div>
    </section>

    <!-- CREDENTIAL GATE (buyer trust): add "Registered Anthropic Partner" here only after Anthropic confirms registration. Kept out until then (FTC claims discipline). -->

    <section class="cn-sec cn-close sec-blush" id="start" aria-labelledby="start-h">
      <div class="wrap">
        <p class="kicker" data-in>The next line item</p>
        <h2 class="sec-title" id="start-h" data-in>Tell me what is slow.</h2>
        <p class="close-sub" data-in>I will tell you what it costs to fix. Start with the diagnostic, or just email me.</p>
        <div class="cn__cta" data-in>
          <a class="btn" href="/#start" data-magnetic>Start with a diagnostic <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
          <a class="link-arrow" href={`mailto:${site.email}?subject=${encodeURIComponent('AI for my business')}`}>Email Ryan <span class="a" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .cn { padding-top: clamp(2.6rem, 5vw, 3.6rem); }
  .cn__head { max-width: 720px; }
  .cn__title { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; line-height: 1.05; margin-top: 8px; text-wrap: balance; }
  .cn__lead { margin-top: 1.3rem; font-size: var(--fs-lead); line-height: 1.6; color: var(--ink-2); max-width: 62ch; }

  .cn-sec { padding-block: clamp(2.8rem, 6vw, 4.4rem); }
  .cn-sec.sec-blush { margin-top: clamp(2.8rem, 6vw, 4.4rem); }
  .cn-sec.sec-blush > .wrap { padding-inline: 0; }

  .steps { margin-top: 1.6rem; border-bottom: 1px solid var(--hairline); }
  .step { padding: 1.4rem 0; border-top: 1px solid var(--hairline); }
  .step:first-child { border-top: 2px solid var(--ink); }
  .step__row { display: flex; align-items: baseline; gap: 14px; }
  .step__k { font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .step__price { font-family: var(--font-slab); font-weight: 600; font-size: 22px; color: var(--burgundy); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .step__d { margin-top: 8px; color: var(--ink-2); font-size: var(--fs-small); max-width: 62ch; }
  .cn__basis { margin-top: 1.2rem; font-size: var(--fs-small); color: var(--ink-2); max-width: 60ch; }

  .build { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 1.8rem; background: var(--hairline); border: 1px solid var(--hairline); }
  .build__item { display: flex; flex-direction: column; gap: 6px; padding: 1.3rem 1.4rem; background: var(--blush); text-decoration: none; color: inherit; transition: background var(--dur-fast) ease; }
  .build__item:hover { background: var(--ground); }
  .build__k { font-weight: 700; font-size: 17px; color: var(--ink); }
  .build__go { color: var(--burgundy); transition: transform var(--dur-fast) var(--ease-out); display: inline-block; }
  .build__item:hover .build__go { transform: translateX(3px); }
  .build__d { color: var(--ink-2); font-size: var(--fs-small); }
  .cn__note { margin-top: 1.4rem; font-size: var(--fs-small); color: var(--ink-2); max-width: 64ch; }

  .cn__links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2rem; margin-top: 1.4rem; }
  .cn__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 1.4rem; }
  .cn-close .close-sub { margin-top: 12px; color: var(--ink-2); max-width: 48ch; }

  @media (max-width: 680px) {
    .build { grid-template-columns: 1fr; }
    .step__row { flex-wrap: wrap; }
    .step .leader { display: none; }
    .step__price { margin-left: auto; }
  }
</style>
