---
import DemoLayout from '../../../../layouts/DemoLayout.astro';
// CRAFTED STATIC example: a small-business bookkeeping practice. Editorial serif (system
// Georgia), warm paper palette, deep-pine accent - a look built for THIS business, distinct
// from both Open Book and the generic foil, and with NO motion (the point: even a still page
// can be composed and specific, not a template). Fictional business, illustrative prices.
const services = [
  { name: 'Monthly bookkeeping', note: 'Every transaction categorized, reconciled, and closed', price: 'from $350/mo' },
  { name: 'Cleanup & catch-up', note: 'Behind on the books? We get you current, one month at a time', price: 'quoted' },
  { name: 'Payroll coordination', note: 'Runs on time, filed on time, no chasing', price: 'from $90/mo' },
  { name: 'Reports & insights', note: 'A plain-English P&L and cash view, not just a spreadsheet', price: 'included' },
  { name: 'Tax-ready books', note: 'Hand your accountant clean numbers, not a shoebox', price: 'included' },
];
---
<DemoLayout title="Marlow & Vale: bookkeeping for small business" accent="#1E4635">
  <div class="m">
    <header class="m-top">
      <a class="m-logo" href="#top">Marlow <span>&amp;</span> Vale</a>
      <nav class="m-top__nav">
        <a href="#services">Services</a>
        <a href="#how">How it works</a>
        <a href="#contact" class="m-top__cta">Book a call</a>
      </nav>
    </header>

    <section class="m-hero" id="top">
      <div class="m-hero__copy">
        <p class="m-eyebrow">Bookkeeping for small business · Boise</p>
        <h1>Know exactly where your money stands, every month.</h1>
        <p class="m-lead">
          We keep the books for trades, shops, and studios that would rather be doing the work than
          reconciling it. Clean numbers, a real person who knows your account, and one fixed monthly
          fee with no surprises.
        </p>
        <div class="m-hero__cta">
          <a href="#contact" class="m-btn">Book a free 20-minute call</a>
          <a href="#services" class="m-textlink">See what's included &rarr;</a>
        </div>
      </div>
      <aside class="m-close" aria-label="Sample monthly close">
        <div class="m-close__head"><span>Monthly close</span><span class="m-close__tag">August</span></div>
        <dl class="m-close__rows">
          <div><dt>Income</dt><dd>$48,210</dd></div>
          <div><dt>Expenses</dt><dd>$31,540</dd></div>
          <div class="m-close__net"><dt>Net</dt><dd>$16,670</dd></div>
        </dl>
        <p class="m-close__foot">Reconciled and closed on the 5th. Every month.</p>
      </aside>
    </section>

    <section class="m-services" id="services">
      <div class="m-sec-head">
        <h2>What we do</h2>
        <p>Pick the piece you need, or the whole thing. It is priced up front, either way.</p>
      </div>
      <ul class="m-list">
        {services.map((s) => (
          <li class="m-row">
            <span class="m-row__name">{s.name}</span>
            <span class="m-row__note">{s.note}</span>
            <span class="m-row__price">{s.price}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="m-how" id="how">
      <div class="m-sec-head"><h2>How it works</h2></div>
      <ol class="m-steps">
        <li><span class="m-steps__n">01</span><h3>A short call</h3><p>Twenty minutes to understand your business and where the books stand today. No charge, no pitch.</p></li>
        <li><span class="m-steps__n">02</span><h3>We get you current</h3><p>If you are behind, we catch the books up first, so we are all working from the same, correct numbers.</p></li>
        <li><span class="m-steps__n">03</span><h3>Closed by the 5th</h3><p>From then on, every month is reconciled and closed by the 5th, with a report you can actually read.</p></li>
      </ol>
    </section>

    <section class="m-cta" id="contact">
      <h2>No surprises. One fixed monthly fee.</h2>
      <p>Tell us where the books stand and we will tell you the price before you commit to anything.</p>
      <a href="#top" class="m-btn m-btn--light">Request your free call</a>
      <p class="m-cta__fine">Boise and the Treasure Valley · Remote across Idaho</p>
    </section>

    <footer class="m-foot">
      <span class="m-logo m-logo--sm">Marlow &amp; Vale</span>
      <span>Bookkeeping · Boise, Idaho</span>
    </footer>
  </div>
</DemoLayout>

<style>
  .m {
    --paper: #FBF8F2; --ink: #221F1A; --ink-2: #5C554B; --pine: #1E4635; --pine-d: #163529;
    --sage: #E8EDE6; --line: #E3DCCF; --brass: #B08544;
    font-family: Georgia, "Times New Roman", "Iowan Old Style", serif;
    color: var(--ink); background: var(--paper); line-height: 1.55; overflow-x: hidden;
  }
  .m ::selection { background: var(--pine); color: #fff; }
  .m h1, .m h2, .m h3 { font-weight: 700; letter-spacing: -0.01em; line-height: 1.1; }
  .m section { max-width: 1080px; margin: 0 auto; padding: clamp(56px, 9vw, 100px) 28px; }
  .m-sans { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .m-eyebrow, .m-top__nav, .m-row__price, .m-steps__n, .m-close, .m-cta__fine, .m-foot {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  /* top bar */
  .m-top { display: flex; align-items: center; justify-content: space-between; max-width: 1080px; margin: 0 auto; padding: 22px 28px; }
  .m-logo { font-size: 23px; font-weight: 700; letter-spacing: 0.01em; text-decoration: none; color: var(--pine); }
  .m-logo span { color: var(--brass); font-style: italic; }
  .m-top__nav { display: flex; align-items: center; gap: 26px; font-size: 15px; }
  .m-top__nav a { text-decoration: none; color: var(--ink-2); }
  .m-top__nav a:hover { color: var(--pine); }
  .m-top__cta { color: var(--pine) !important; font-weight: 600; border-bottom: 1.5px solid var(--brass); padding-bottom: 2px; }
  @media (max-width: 620px) { .m-top__nav a:not(.m-top__cta) { display: none; } }

  /* hero */
  .m-hero { display: grid; grid-template-columns: 1.35fr 0.85fr; gap: clamp(30px, 5vw, 64px); align-items: center; padding-top: clamp(40px, 6vw, 70px); }
  @media (max-width: 820px) { .m-hero { grid-template-columns: 1fr; } }
  .m-eyebrow { font-size: 13px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--pine); font-weight: 600; margin: 0 0 18px; }
  .m-hero h1 { font-size: clamp(34px, 5.4vw, 56px); margin: 0; max-width: 15ch; }
  .m-lead { font-size: clamp(17px, 2vw, 19px); color: var(--ink-2); margin: 22px 0 30px; max-width: 46ch; }
  .m-hero__cta { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .m-btn {
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; font-weight: 600; font-size: 15.5px;
    background: var(--pine); color: #fff; text-decoration: none; padding: 13px 24px; border-radius: 4px;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .m-btn:hover { background: var(--pine-d); transform: translateY(-1px); }
  .m-textlink { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 15px; color: var(--pine); text-decoration: none; font-weight: 500; }
  .m-textlink:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* sample close card */
  .m-close { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 22px 24px; box-shadow: 0 1px 0 var(--line); }
  .m-close__head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .m-close__tag { color: var(--pine); font-weight: 600; }
  .m-close__rows { margin: 6px 0 0; }
  .m-close__rows > div { display: flex; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .m-close__rows dt { color: var(--ink-2); margin: 0; }
  .m-close__rows dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; color: var(--ink); }
  .m-close__net { border-bottom: none !important; }
  .m-close__net dt, .m-close__net dd { color: var(--pine) !important; font-size: 17px !important; }
  .m-close__foot { font-size: 12.5px; color: var(--ink-2); margin: 10px 0 0; }

  /* services */
  .m-services { border-top: 1px solid var(--line); }
  .m-sec-head { margin-bottom: 34px; }
  .m-sec-head h2 { font-size: clamp(26px, 3.6vw, 36px); margin: 0; }
  .m-sec-head p { color: var(--ink-2); font-size: 17px; margin: 12px 0 0; max-width: 44ch; }
  .m-list { list-style: none; margin: 0; padding: 0; }
  .m-row { display: grid; grid-template-columns: 1fr; gap: 4px 20px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) { .m-row { grid-template-columns: 260px 1fr auto; align-items: baseline; } }
  .m-row__name { font-size: 20px; font-weight: 700; color: var(--ink); }
  .m-row__note { color: var(--ink-2); font-size: 16px; }
  .m-row__price { font-size: 14px; color: var(--pine); font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }

  /* how */
  .m-how { background: var(--sage); max-width: none; }
  .m-how > * { max-width: 1080px; margin-left: auto; margin-right: auto; }
  .m-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px; }
  @media (max-width: 760px) { .m-steps { grid-template-columns: 1fr; gap: 26px; } }
  .m-steps li { border-top: 2px solid var(--pine); padding-top: 18px; }
  .m-steps__n { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; color: var(--brass); }
  .m-steps h3 { font-size: 21px; margin: 10px 0 8px; }
  .m-steps p { color: var(--ink-2); font-size: 15.5px; margin: 0; }

  /* cta */
  .m-cta { background: var(--pine); max-width: none; text-align: center; color: #fff; }
  .m-cta h2 { font-size: clamp(26px, 4vw, 40px); margin: 0 auto; max-width: 20ch; color: #fff; }
  .m-cta > p { color: rgba(255,255,255,0.82); font-size: 18px; margin: 16px auto 28px; max-width: 46ch; }
  .m-btn--light { background: #fff; color: var(--pine); }
  .m-btn--light:hover { background: #F2EFE7; }
  .m-cta__fine { font-size: 13px; color: rgba(255,255,255,0.65); margin: 24px 0 0; letter-spacing: 0.03em; }

  /* foot */
  .m-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid var(--line); font-size: 13px; color: var(--ink-2); padding-top: 30px; padding-bottom: 40px; }
  .m-logo--sm { font-size: 16px; }
</style>
