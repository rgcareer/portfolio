---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  jsonLd?: Record<string, unknown>; // per-page schema override (home passes ProfessionalService/LocalBusiness)
}
const { title, description, active, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const desc = description ?? site.blurb;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL('/og.png', site.url).toString();

const sameAs = [site.links.linkedin, site.links.github].filter((u) => u && !u.includes('REPLACE'));
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  ...(sameAs.length ? { sameAs } : {}),
};
const ld = jsonLd ?? personLd;
---

<!doctype html>
<html lang="en" data-theme="pine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0F3327" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/syne-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <noscript><style>[data-in], [data-hero-in] { opacity: 1 !important; transform: none !important; }</style></noscript>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar__in">
        <a class="brand" href="/" aria-label={`${site.name}, led by Ryan Garver`}>
          <span class="wm" aria-hidden="true">get smart ai<span class="disc"></span></span>
          <small>led by Ryan Garver</small>
        </a>
        <nav aria-label="Primary">
          <ul class="nav__links">
            {site.nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class:list={['nav__link', { 'is-active': active === n.key }]}
                  aria-current={active === n.key ? 'page' : undefined}
                >{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="hire" href="/work">Hiring for AI enablement? See the work</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot" aria-label="Footer">
      <div class="wrap">
        <div class="foot__col">
          <span class="wm" aria-hidden="true">get smart ai<span class="disc"></span></span>
          <span class="sr-only">Get Smart AI</span>
          <p class="foot__entity">{site.legalEntity} · {site.legalLocation}</p>
          <p class="foot__meta">© {site.year} Smart Business AI LLC</p>
        </div>
        <div class="foot__col">
          <div class="foot__links">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/accessibility">Accessibility</a>
          </div>
          <div class="foot__links">
            <a href={`mailto:${site.email}`}>Email</a>
            <a href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
            {site.links.github && <a href={site.links.github} rel="me noopener" target="_blank">GitHub</a>}
          </div>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
