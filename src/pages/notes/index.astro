---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notes } from '../../config/notes';
const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---
<BaseLayout title="Notes" active="notes" description="Short write-ups from building and shipping: what broke, why, and the checking habit it left me with. Mostly about verifying a thing actually works.">
  <section class="container nx">
    <header class="nx__head">
      <p class="kicker" data-in>Notes</p>
      <h1 class="nx__title" data-in>What broke, and what it taught me</h1>
      <p class="nx__sub" data-in>Short write-ups from building and shipping. Each one is a real bug or a wrong assumption from this site and the tools behind it, and the checking habit it left me with.</p>
    </header>

    <div class="ledger nx-list" data-in>
      {notes.map((n) => (
        <a class="line-item nx-item" href={`/notes/${n.slug}`}>
          <div class="li-row">
            <span class="li-name nx-name">{n.title}</span>
            <span class="leader" aria-hidden="true"></span>
            <span class="nx-date">{fmt(n.date)}<small>{n.readingTime}</small></span>
            <span class="nx-go" aria-hidden="true">&rarr;</span>
          </div>
          <p class="li-sub nx-summary">{n.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .nx { padding-top: clamp(2.6rem, 5vw, 3.6rem); padding-bottom: clamp(4rem, 9vw, 7rem); }
  .nx__head { max-width: 760px; }
  .nx__title { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; line-height: 1.05; margin-top: 8px; text-wrap: balance; }
  .nx__sub { margin-top: 1.2rem; font-size: var(--fs-lead); color: var(--ink-2); max-width: 56ch; line-height: 1.55; }

  .nx-list { margin-top: clamp(2rem, 5vw, 3rem); }
  .nx-item { display: block; text-decoration: none; color: inherit; transition: padding-left var(--dur-fast) var(--ease-out); }
  .nx-item:hover { padding-left: 8px; }
  .nx-name { color: var(--ink); transition: color var(--dur-fast) ease; white-space: normal; }
  .nx-item:hover .nx-name { color: var(--burgundy); }
  .nx-date {
    font-family: var(--font-slab); font-size: var(--fs-small); color: var(--muted);
    white-space: nowrap; display: inline-flex; flex-direction: column; align-items: flex-end; line-height: 1.2;
  }
  .nx-date small { font-family: var(--font-display); font-size: 11.5px; color: var(--muted); margin-top: 2px; }
  .nx-go { flex: none; color: var(--dot); font-size: 18px; align-self: center; margin-left: 4px; transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) ease; }
  .nx-item:hover .nx-go { color: var(--burgundy); transform: translateX(4px); }
  .nx-summary { margin-top: 8px; max-width: 64ch; }

  @media (max-width: 640px) {
    .li-row { flex-wrap: wrap; align-items: baseline; }
    .nx-date { flex-direction: row; align-items: baseline; gap: 6px; margin-left: auto; }
    .nx-date small { margin-top: 0; }
    .nx-go { display: none; }
  }
</style>
