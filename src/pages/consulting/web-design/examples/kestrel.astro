---
import DemoLayout from '../../../../layouts/DemoLayout.astro';
// CRAFTED MOTION example: a neighborhood coffee roaster. Bold display type, warm espresso/
// cream palette, and tasteful motion built with CSS + a tiny vanilla IntersectionObserver
// (no libraries - the live-site CSP blocks third-party scripts anyway). Motion: a hero
// entrance, a running marquee, scroll reveals, rising steam, hover states. All of it degrades
// to a fully-composed still page under prefers-reduced-motion or with JS off. Fictional shop.
const roasts = [
  { name: 'Kestrel House', kind: 'Signature blend', notes: 'Cocoa, brown sugar, toasted almond', price: '$17', shade: '#6F3B1E' },
  { name: 'Guji, Ethiopia', kind: 'Single origin', notes: 'Blueberry, jasmine, raw honey', price: '$21', shade: '#9C5A2A' },
  { name: 'Sumatra Dark', kind: 'Single origin', notes: 'Cedar, dark chocolate, molasses', price: '$19', shade: '#42261A' },
];
const marquee = ['Single origin', 'Small batch', 'Roasted weekly', 'Boise, Idaho', 'Since 2019'];
---
<DemoLayout title="Kestrel Coffee: small batch, roasted in Boise" accent="#2A1A12">
  <div class="kv">
    <header class="kv-nav">
      <a class="kv-logo" href="#top">Kestrel<span>Coffee</span></a>
      <nav class="kv-nav__links">
        <a href="#roasts">Roasts</a>
        <a href="#story">Our story</a>
        <a href="#visit">Visit</a>
      </nav>
    </header>

    <section class="kv-hero" id="top">
      <div class="kv-steam" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="kv-hero__eyebrow kv-hero__line" style="--hd:0s">Neighborhood roaster · est. 2019</p>
      <h1>
        <span class="kv-hero__line" style="--hd:.08s">Small batch.</span>
        <span class="kv-hero__line kv-hero__accent" style="--hd:.18s">Roasted in Boise.</span>
      </h1>
      <p class="kv-hero__sub kv-hero__line" style="--hd:.3s">
        Twelve pounds at a time, every week, from a little shop on Idaho Street. No burnt beans,
        no mystery blends. Just coffee we would drink ourselves.
      </p>
      <div class="kv-hero__cta kv-hero__line" style="--hd:.42s">
        <a href="#roasts" class="kv-btn">Shop the roasts</a>
        <a href="#visit" class="kv-textlink">Find the shop &rarr;</a>
      </div>
    </section>

    <div class="kv-marq" aria-hidden="true">
      <div class="kv-marq__row">
        {[...marquee, ...marquee].map((m) => (<span>{m}<i>✦</i></span>))}
      </div>
    </div>

    <section class="kv-roasts" id="roasts">
      <div class="kv-head kv-reveal">
        <h2>This week's roasts</h2>
        <p>Roasted Monday, on the shelf Tuesday, ground to order.</p>
      </div>
      <div class="kv-grid">
        {roasts.map((r, i) => (
          <article class="kv-roast kv-reveal" style={`--d:${i * 0.1}s`}>
            <div class="kv-roast__bag" style={`--bag:${r.shade}`}>
              <span class="kv-roast__badge">{r.kind}</span>
              <span class="kv-roast__nm">{r.name}</span>
            </div>
            <div class="kv-roast__meta">
              <p class="kv-roast__notes">{r.notes}</p>
              <div class="kv-roast__buy"><span class="kv-roast__price">{r.price}</span><span class="kv-roast__add">Add to bag +</span></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="kv-story" id="story">
      <div class="kv-story__copy kv-reveal">
        <h2>We roast it, we pour it, we know your name.</h2>
        <p>
          Kestrel started with one roaster in a garage and a stubborn idea: that a cup of coffee should
          taste like the place it came from. We still roast in small batches so nothing sits, and we still
          pull every shot by hand.
        </p>
        <a href="#visit" class="kv-textlink kv-textlink--dark">Come say hello &rarr;</a>
      </div>
      <div class="kv-story__stat kv-reveal" style="--d:.12s">
        <span class="kv-story__big">12 lb</span>
        <span class="kv-story__cap">batches, roasted every single week</span>
      </div>
    </section>

    <section class="kv-visit" id="visit">
      <div class="kv-head kv-reveal"><h2>Come find us</h2></div>
      <div class="kv-visit__grid">
        <div class="kv-reveal"><span class="kv-visit__k">Where</span><p>1142 W Idaho Street<br />Boise, Idaho</p></div>
        <div class="kv-reveal" style="--d:.08s"><span class="kv-visit__k">Hours</span><p>Mon-Fri · 6:30a to 4p<br />Sat-Sun · 7a to 3p</p></div>
        <div class="kv-reveal" style="--d:.16s"><span class="kv-visit__k">Say hi</span><p>hello@kestrel.example<br />@kestrelcoffee</p></div>
      </div>
    </section>

    <footer class="kv-foot">
      <span class="kv-logo kv-logo--sm">Kestrel<span>Coffee</span></span>
      <span>Roasted in Boise, Idaho</span>
    </footer>
  </div>
</DemoLayout>

<style>
  .kv {
    --espresso: #2A1A12; --espresso-2: #3A2418; --cream: #F4E9D8; --paper: #FBF3E6;
    --orange: #C8552B; --amber: #D9A441; --ink: #2A1A12; --ink-2: #6B5647;
    font-family: "Helvetica Neue", ui-sans-serif, system-ui, -apple-system, Arial, sans-serif;
    color: var(--ink); background: var(--paper); line-height: 1.5; overflow-x: hidden;
  }
  .kv ::selection { background: var(--orange); color: #fff; }
  .kv h1, .kv h2 { font-weight: 800; letter-spacing: -0.03em; line-height: 0.98; }

  /* reveal contract: visible by default; hidden only when js AND motion allowed */
  html.js:not([data-reduce]) .kv-reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s cubic-bezier(.2,.7,.2,1), transform 0.8s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0s); }
  html.js:not([data-reduce]) .kv-reveal.in { opacity: 1; transform: none; }

  /* nav */
  .kv-nav { position: absolute; top: 0; left: 0; right: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; max-width: 1120px; margin: 0 auto; padding: 24px 28px; }
  .kv-logo { font-weight: 800; font-size: 21px; letter-spacing: -0.02em; text-decoration: none; color: var(--cream); }
  .kv-logo span { color: var(--amber); }
  .kv-nav__links { display: flex; gap: 26px; }
  .kv-nav__links a { text-decoration: none; color: rgba(244,233,216,0.82); font-weight: 600; font-size: 15px; }
  .kv-nav__links a:hover { color: var(--amber); }
  @media (max-width: 620px) { .kv-nav__links { display: none; } }

  /* hero */
  .kv-hero { position: relative; background: radial-gradient(120% 90% at 70% 0%, var(--espresso-2) 0%, var(--espresso) 60%); color: var(--cream); padding: clamp(120px, 20vw, 190px) 28px clamp(70px, 12vw, 120px); max-width: none; overflow: hidden; }
  .kv-hero > * { position: relative; z-index: 2; max-width: 1120px; margin-left: auto; margin-right: auto; }
  .kv-hero__eyebrow { text-transform: uppercase; letter-spacing: 0.2em; font-size: 13px; font-weight: 700; color: var(--amber); margin: 0 0 20px; }
  .kv-hero h1 { font-size: clamp(48px, 12vw, 128px); margin: 0; }
  .kv-hero h1 span { display: block; }
  .kv-hero__accent { color: var(--orange); }
  .kv-hero__sub { font-size: clamp(17px, 2.2vw, 21px); color: rgba(244,233,216,0.82); max-width: 46ch; margin: 26px 0 34px; font-weight: 400; }
  .kv-hero__cta { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
  .kv-btn { background: var(--orange); color: #fff; text-decoration: none; font-weight: 700; font-size: 16px; padding: 15px 30px; border-radius: 2px; transition: background 0.18s ease, transform 0.18s ease; }
  .kv-btn:hover { background: #b0481f; transform: translateY(-2px); }
  .kv-textlink { color: var(--cream); text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 2px solid var(--amber); padding-bottom: 3px; }
  .kv-textlink:hover { color: var(--amber); }
  .kv-textlink--dark { color: var(--espresso); }

  /* hero entrance */
  html.js:not([data-reduce]) .kv-hero__line { opacity: 0; transform: translateY(38px); animation: kvRise 0.9s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: var(--hd, 0s); }
  @keyframes kvRise { to { opacity: 1; transform: none; } }

  /* steam */
  .kv-steam { position: absolute; top: 20%; right: 12%; z-index: 1; width: 90px; height: 200px; opacity: 0.5; }
  .kv-steam span { position: absolute; bottom: 0; width: 12px; height: 12px; border-radius: 50%; background: rgba(244,233,216,0.5); filter: blur(6px); }
  .kv-steam span:nth-child(1) { left: 20%; }
  .kv-steam span:nth-child(2) { left: 46%; }
  .kv-steam span:nth-child(3) { left: 72%; }
  html.js:not([data-reduce]) .kv-steam span { animation: kvSteam 4s ease-in infinite; }
  .kv-steam span:nth-child(2) { animation-delay: 1.1s; }
  .kv-steam span:nth-child(3) { animation-delay: 2.2s; }
  @keyframes kvSteam { 0% { transform: translateY(0) scale(1); opacity: 0; } 25% { opacity: 0.6; } 100% { transform: translateY(-180px) scale(2.4); opacity: 0; } }
  @media (max-width: 720px) { .kv-steam { display: none; } }

  /* marquee */
  .kv-marq { background: var(--orange); color: #fff; overflow: hidden; white-space: nowrap; padding: 15px 0; }
  .kv-marq__row { display: inline-flex; will-change: transform; }
  html.js:not([data-reduce]) .kv-marq__row { animation: kvMarq 24s linear infinite; }
  @keyframes kvMarq { to { transform: translateX(-50%); } }
  .kv-marq span { display: inline-flex; align-items: center; font-weight: 800; font-size: 17px; letter-spacing: 0.02em; text-transform: uppercase; padding: 0 4px; }
  .kv-marq i { font-style: normal; margin: 0 26px; color: rgba(255,255,255,0.55); }

  /* sections */
  .kv section { max-width: 1120px; margin: 0 auto; }
  .kv-roasts, .kv-story, .kv-visit { padding: clamp(56px, 9vw, 100px) 28px; }
  .kv-head { margin-bottom: 42px; }
  .kv-head h2 { font-size: clamp(30px, 5vw, 52px); margin: 0; }
  .kv-head p { color: var(--ink-2); font-size: 18px; margin: 12px 0 0; }

  /* roasts grid */
  .kv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 820px) { .kv-grid { grid-template-columns: 1fr; max-width: 420px; } }
  .kv-roast { background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 0 rgba(42,26,18,0.08); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .kv-roast:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(42,26,18,0.16); }
  .kv-roast__bag { position: relative; aspect-ratio: 4 / 3; background: var(--bag); display: flex; flex-direction: column; justify-content: flex-end; padding: 22px; color: #fff; }
  .kv-roast__badge { position: absolute; top: 16px; left: 16px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; background: rgba(255,255,255,0.18); padding: 5px 10px; border-radius: 2px; }
  .kv-roast__nm { font-size: 27px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .kv-roast__meta { padding: 20px 22px 24px; }
  .kv-roast__notes { color: var(--ink-2); font-size: 15px; margin: 0 0 16px; }
  .kv-roast__buy { display: flex; align-items: center; justify-content: space-between; }
  .kv-roast__price { font-weight: 800; font-size: 20px; color: var(--espresso); }
  .kv-roast__add { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--orange); }

  /* story */
  .kv-story { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(30px, 6vw, 70px); align-items: center; background: var(--cream); max-width: none; }
  .kv-story > * { max-width: 1120px; }
  @media (max-width: 820px) { .kv-story { grid-template-columns: 1fr; } }
  .kv-story h2 { font-size: clamp(28px, 4.4vw, 46px); margin: 0 0 20px; max-width: 16ch; }
  .kv-story__copy p { color: var(--ink-2); font-size: 17px; max-width: 48ch; margin: 0 0 20px; }
  .kv-story__stat { text-align: center; }
  .kv-story__big { display: block; font-size: clamp(70px, 14vw, 130px); font-weight: 800; color: var(--orange); letter-spacing: -0.04em; line-height: 0.9; }
  .kv-story__cap { color: var(--ink-2); font-size: 16px; }

  /* visit */
  .kv-visit__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  @media (max-width: 720px) { .kv-visit__grid { grid-template-columns: 1fr; gap: 24px; } }
  .kv-visit__grid > div { border-top: 3px solid var(--espresso); padding-top: 16px; }
  .kv-visit__k { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--orange); margin-bottom: 10px; }
  .kv-visit__grid p { font-size: 18px; margin: 0; line-height: 1.5; }

  /* foot */
  .kv-foot { background: var(--espresso); color: rgba(244,233,216,0.7); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 30px 28px; font-size: 14px; }
  .kv-foot .kv-logo--sm { font-size: 17px; color: var(--cream); }
</style>

<script>
  const items = document.querySelectorAll('.kv-reveal');
  const reduce = document.documentElement.hasAttribute('data-reduce');
  if (!reduce && 'IntersectionObserver' in window && items.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    items.forEach((el) => io.observe(el));
    // failsafe: never leave content hidden
    setTimeout(() => items.forEach((el) => el.classList.add('in')), 2600);
  } else {
    items.forEach((el) => el.classList.add('in'));
  }
</script>
