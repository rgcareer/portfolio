---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCase } from '../../config/work';

// /work = the recruiter proof surface (reached via the quiet "Hiring?" link, and
// indexable). Open Book ledger casebook. Order per the flagship-signal memory:
// ENABLEMENT LEADS (public, verifiable tools first), then the systems I ran. The
// role claim and the flight-risk answer live here ONCE, never on the buyer hero.
const lanes = [
  {
    label: 'Enablement and adoption',
    note: 'Tools that help people actually use AI, shipped in public so you can check them yourself: install them, read the source, run the tests.',
    slugs: ['should-i-automate-this', 'evalcard', 'sop-mcp', 'cs-prompt-field-kit'],
  },
  {
    label: 'Systems I built and ran',
    note: 'Production I designed, ran, and measured myself, under real load, with the receipts kept and reproducible.',
    slugs: ['operation-hired', 'ai-ops-workflow', 'victoria-reliability-layer', 'competitor-intel-mcp', 'product-generation-pipeline'],
  },
];

const title = 'Work: AI enablement tools and systems I have built';
const description =
  'Selected work by Ryan Garver: AI adoption and enablement tools shipped in public, plus production systems built, run, and measured firsthand. Real code, real numbers, verifiable.';
---
<BaseLayout title={title} description={description} active="work">
  <section class="container wk">
    <header class="wk__head">
      <p class="kicker" data-in>Selected work</p>
      <h1 class="wk__title" data-in>I build AI tools, and the layer that gets them adopted.</h1>
      <p class="wk__sub" data-in>
        My work is AI enablement: the tools that make a model useful to a real team, and the systems
        that keep it honest once it is running. Below are the ones I can show. The enablement tools are
        public: installable, source-readable, tested. The systems I built and ran myself, and I kept
        the numbers.
      </p>
      <p class="wk__flight" data-in>
        A fair question from a hiring manager: I run a small practice, so am I about to leave? No. The
        practice is the workshop where I keep this work current and measured on real problems. A role
        is where it runs at the scale one person cannot reach, with a team and stakes bigger than a
        client list. The practice is how I stay sharp for the job, not an exit from it.
      </p>
    </header>

    {lanes.map((lane) => (
      <div class="wk-lane" data-in>
        <p class="wk-lane__label">{lane.label}</p>
        <p class="wk-lane__note">{lane.note}</p>
        <div class="ledger wk-list">
          {lane.slugs.map((slug) => {
            const c = getCase(slug)!;
            return (
              <a class="line-item wk-item" href={`/work/${c.slug}`}>
                <div class="li-row">
                  <span class="li-name wk-name">{c.title}</span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="wk-fig">{c.metrics[0].value}<small>{c.metrics[0].label}</small></span>
                  <span class="wk-go" aria-hidden="true">&rarr;</span>
                </div>
                <p class="li-sub wk-tag">{c.tagline}</p>
                <p class="wk-meta">{c.status} · {c.tags.join(' · ')}</p>
              </a>
            );
          })}
        </div>
      </div>
    ))}

    <p class="slot-empty" data-in>More is in progress: a sprint of small AI tools (caching, docs integrity, cost control, agent forensics). Each one lands here only when it is finished and independently verified, with numbers you can check. Nothing goes on this page without a real result behind it.</p>

    <div class="wk-foot" data-in>
      <p class="wk-foot__lead">Want the version wired into your own business, with the price next to each line?</p>
      <a class="btn" href="/#rates" data-magnetic>See the rate card <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .wk { padding-top: clamp(2.6rem, 5vw, 3.6rem); padding-bottom: clamp(4rem, 9vw, 7rem); }
  .wk__head { max-width: 720px; }
  .wk__title { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; line-height: 1.05; margin-top: 8px; text-wrap: balance; }
  .wk__sub { margin-top: 1.3rem; font-size: var(--fs-lead); line-height: 1.6; color: var(--ink-2); max-width: 60ch; }
  .wk__flight {
    margin-top: 1.4rem; padding: 1rem 1.2rem; background: var(--blush);
    border-left: 3px solid var(--dot); font-size: var(--fs-small); line-height: 1.6;
    color: var(--ink-2); max-width: 62ch;
  }

  .wk-lane { margin-top: clamp(2.8rem, 6vw, 4.2rem); }
  .wk-lane__label {
    font-family: var(--font-slab); font-size: var(--fs-kicker); font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--burgundy);
  }
  .wk-lane__note { margin-top: 8px; color: var(--ink-2); font-size: var(--fs-small); max-width: 58ch; }
  .wk-list { margin-top: 1.5rem; }

  /* .line-item / .li-row / .li-name / .leader / .li-sub are the Open Book ledger classes */
  .wk-item { display: block; text-decoration: none; color: inherit; transition: padding-left var(--dur-fast) var(--ease-out); }
  .wk-item:hover { padding-left: 8px; }
  .wk-name { color: var(--ink); transition: color var(--dur-fast) ease; white-space: normal; }
  .wk-item:hover .wk-name { color: var(--burgundy); }
  .wk-fig {
    font-family: var(--font-slab); font-weight: 600; font-size: 19px; color: var(--burgundy);
    font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; display: inline-flex;
    flex-direction: column; align-items: flex-end; line-height: 1.15;
  }
  .wk-fig small {
    font-family: var(--font-display); font-size: 11.5px; font-weight: 500; color: var(--muted);
    letter-spacing: 0.02em; margin-top: 2px;
  }
  .wk-go { flex: none; color: var(--dot); font-size: 18px; align-self: center; transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) ease; margin-left: 4px; }
  .wk-item:hover .wk-go { color: var(--burgundy); transform: translateX(4px); }
  .wk-tag { margin-top: 8px; }
  .wk-meta {
    margin-top: 7px; font-family: var(--font-slab); font-size: var(--fs-caption); font-weight: 500;
    letter-spacing: 0.03em; color: var(--muted);
  }

  .wk-foot {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.8rem;
    margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2rem; border-top: 2px solid var(--ink);
  }
  .wk-foot__lead { font-family: var(--font-slab); font-weight: 500; font-size: var(--fs-lead); color: var(--ink); max-width: 40ch; }

  @media (max-width: 640px) {
    .li-row { flex-wrap: wrap; align-items: baseline; }
    .wk-fig { flex-direction: row; align-items: baseline; gap: 6px; text-align: left; margin-left: auto; }
    .wk-fig small { margin-top: 0; }
    .wk-go { display: none; }
  }
</style>
