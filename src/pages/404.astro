---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" description="That page doesn't exist.">
  <section class="wrap nf" aria-label="Page not found">
    <span class="nf__disc" aria-hidden="true"></span>
    <p class="eyebrow">Error 404</p>
    <h1 class="nf__big">Nothing here.</h1>
    <p class="nf__sub">This page moved or never existed. The work is still where it should be.</p>
    <div class="nf__cta">
      <a class="btn" href="/">Back to the home</a>
      <a class="link-quiet" href="/work">See the work</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* "Empty" per contract: the green light, off (an unlit outline disc). */
  .nf { min-height: 72svh; display: flex; flex-direction: column; justify-content: center; padding-block: var(--space-24); }
  .nf__disc { width: 3.2rem; height: 3.2rem; border-radius: 50%; border: 2px solid var(--line-strong); }
  .nf__big { font-family: var(--display); font-size: var(--fs-display); font-weight: 720; margin-top: var(--space-6); max-width: 14ch; }
  .nf__sub { font-size: var(--fs-lead); color: var(--ink-soft); margin-top: var(--space-6); max-width: 40ch; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); align-items: center; margin-top: var(--space-12); }
</style>
