---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page does not exist. The work and the rate card are one click away." noindex={true}>
  <section class="wrap nf" aria-label="Page not found">
    <p class="eyebrow">Error 404</p>
    <h1 class="nf__big">This line item does not exist.</h1>
    <p class="nf__sub">The page moved or was never here. Everything else is still on the books.</p>
    <div class="nf__cta">
      <a class="btn" href="/" data-magnetic>Back to the home <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
      <a class="link-arrow" href="/work">See the work <span class="a" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 66svh; display: flex; flex-direction: column; justify-content: center; padding-block: var(--sect-pad); }
  .nf__big { font-family: var(--font-display); font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; margin-top: 20px; max-width: 16ch; }
  .nf__sub { font-size: var(--fs-lead); color: var(--ink-2); margin-top: 20px; max-width: 44ch; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; margin-top: 40px; }
</style>
