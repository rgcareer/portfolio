---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

// About = the practice + the person, business-forward (charter). The verified career
// pedigree serves buyers (trust) and recruiters (via the résumé link) both. No
// "roles I'm looking for" block here - the recruiter path is the quiet Hiring link
// to /work (charter §6.3). Open Book look. Identity: Ryan Garver, honest-outsider voice.
const throughline = [
  { when: '2004-2015', role: 'Retail management', org: 'Zumiez, Vans, Mainland',
    work: 'Ran teams of 15 to 35 and built the hiring, onboarding, and training that got new people up to speed.' },
  { when: '2015-2019', role: 'Enterprise technology adoption', org: 'Apple',
    work: 'Helped organizations like St. Luke’s and Dutch Bros move onto new tools, trained more than 22 teammates, and brought NPS from 83 to 92.' },
  { when: '2019-2022', role: 'SaaS sales and enablement', org: 'Cradlepoint, Intuit, Vacasa',
    work: 'Moved small businesses onto cloud and SaaS tools, with CRM cleanup, onboarding, and training that held up.' },
  { when: 'Current', role: 'AI product builder', org: 'Smart Business AI LLC',
    work: 'Build AI systems for non-technical business owners, and handle the whole thing myself, from research to support.' },
];
---
<BaseLayout title="About" active="about" description="Ryan Garver: twenty years helping non-technical teams adopt new technology, at Apple, Intuit, Cradlepoint, and Vacasa, now building AI for small businesses in Boise.">
  <section class="container ab">
    <header class="ab__head">
      <p class="kicker" data-in>About</p>
      <h1 class="ab__title" data-in>I help people adopt new technology. My whole career. Now it's AI.</h1>
      <p class="ab__lead" data-in>
        I am {site.firstName}. Across retail, enterprise tech, and SaaS, the work has come down to the
        same thing: helping people who are not technical get comfortable with new tools. AI is that job
        again, and the stakes are higher this time. I am not an agency, and I am not pretending to know
        your trade better than you do. You are the expert on your business. I build the systems.
      </p>
    </header>

    <section class="ab__sec" aria-labelledby="tl-h">
      <h2 class="ab__h" id="tl-h" data-in>The throughline</h2>
      <div class="ab__sec-body">
        <p class="ab__p" data-in>Every job I have had was really the same problem: getting people to adopt something new.</p>
        <ol class="ab__time" data-in>
          {throughline.map((t) => (
            <li class="ab__item">
              <span class="ab__when">{t.when}</span>
              <div class="ab__item-body">
                <span class="ab__role">{t.role} <span class="ab__org">· {t.org}</span></span>
                <p class="ab__work">{t.work}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ab__sec" aria-labelledby="rare-h">
      <h2 class="ab__h" id="rare-h" data-in>The part that's rare</h2>
      <div class="ab__sec-body">
        <div class="ab__combo" data-in>
          <div class="ab__card">
            <span class="ab__card-k">I lead the change</span>
            <p class="ab__card-p">Years of getting people through new tools and processes: the training, the onboarding, the buy-in. This is the human side of adoption, and it is usually where a rollout lives or dies.</p>
          </div>
          <div class="ab__card">
            <span class="ab__card-k">And I build it</span>
            <p class="ab__card-p">I build the AI I talk about: workflow automation, an MCP server, a job-search engine, a multi-agent review system, and the follow-up systems I sell. <a class="link-green" href="/work">See the work</a></p>
          </div>
        </div>
        <p class="ab__pull" data-in>The useful part is the combination.</p>
        <p class="ab__pull-sub" data-in>I can run the adoption side and build the tools. Most people only do one.</p>
      </div>
    </section>

    <section class="ab__sec" aria-labelledby="you-h">
      <h2 class="ab__h" id="you-h" data-in>What that means for you</h2>
      <div class="ab__sec-body">
        <p class="ab__p" data-in>
          If you run a business without an engineering department, you get one person who can find what
          is costing you money, build the fix, and get your people actually using it, with the price on
          the page before any call. If you are hiring, the work is public and the résumé is one click away.
        </p>
        <div class="ab__cta" data-in>
          <a href="/#start" class="btn" data-magnetic>Start with a diagnostic <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
          <a href="/work" class="link-arrow">See the work <span class="a" aria-hidden="true">&rarr;</span></a>
          <a href="/resume" class="link-quiet">Résumé</a>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .ab { padding-top: clamp(2.6rem, 5vw, 3.6rem); padding-bottom: clamp(4rem, 9vw, 7rem); }
  .ab__head { max-width: 820px; }
  .ab__title { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.022em; line-height: 1.06; margin-top: 8px; max-width: 20ch; text-wrap: balance; }
  .ab__lead { font-size: var(--fs-lead); color: var(--ink-2); margin-top: 1.4rem; line-height: 1.6; max-width: 58ch; }

  .ab__sec { margin-top: clamp(3rem, 7vw, 5rem); }
  .ab__sec-body > :first-child { margin-top: 0; }
  @media (min-width: 880px) {
    .ab__sec { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  }
  .ab__h { font-family: var(--font-slab); font-size: var(--fs-kicker); text-transform: uppercase; letter-spacing: 0.16em; color: var(--burgundy); font-weight: 600; }
  .ab__p { font-size: var(--fs-body); color: var(--ink-2); margin-top: 1.1rem; max-width: 58ch; line-height: 1.7; }
  .ab__p strong { color: var(--ink); font-weight: 600; }

  .ab__time { list-style: none; margin-top: 1.8rem; border-left: 1px solid var(--hairline); }
  .ab__item { display: grid; gap: 0.3rem 1.5rem; padding: 0 0 1.8rem 1.6rem; position: relative; }
  .ab__item:last-child { padding-bottom: 0; }
  .ab__item::before { content: ""; position: absolute; left: -3.5px; top: 0.45rem; width: 6px; height: 6px; border-radius: 50%; background: var(--burgundy); }
  @media (min-width: 640px) { .ab__item { grid-template-columns: 110px 1fr; } }
  .ab__when { font-family: var(--font-slab); font-size: var(--fs-caption); color: var(--muted); padding-top: 0.15rem; }
  .ab__role { font-size: var(--fs-body); color: var(--ink); font-weight: 600; }
  .ab__org { color: var(--burgundy); font-weight: 500; font-size: var(--fs-small); }
  .ab__work { color: var(--ink-2); margin-top: 0.4rem; line-height: 1.6; font-size: var(--fs-small); }

  .ab__combo { display: grid; gap: 1px; margin-top: 1.8rem; background: var(--hairline); border: 1px solid var(--hairline); }
  @media (min-width: 720px) { .ab__combo { grid-template-columns: 1fr 1fr; } }
  .ab__card { padding: 1.5rem 1.6rem; background: var(--blush); }
  .ab__card-k { font-family: var(--font-slab); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.14em; color: var(--burgundy); font-weight: 600; }
  .ab__card-p { color: var(--ink-2); margin-top: 0.8rem; line-height: 1.65; font-size: var(--fs-small); }
  .ab__pull { font-family: var(--font-slab); font-weight: 600; font-size: clamp(1.6rem, 3.4vw, 2.4rem); color: var(--ink); line-height: 1.1; margin-top: 2.2rem; max-width: 24ch; letter-spacing: -0.01em; }
  .ab__pull-sub { font-size: var(--fs-lead); color: var(--ink-2); margin-top: 0.9rem; max-width: 44ch; line-height: 1.45; }

  .ab__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 2rem; }
</style>
