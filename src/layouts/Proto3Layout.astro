---
// Standalone layout for the "Open Book" moving mockup (/proto3).
// Mirrors Proto2Layout: no BaseLayout (that carries dark v3 chrome + motion.ts),
// noindex + unlinked, own head for the Open Book fonts. Gate artifact for Ryan's
// on-site feel-gate; /proto (Shelf) + /proto2 (Highlighter) stay for lineage.
import '../styles/proto3.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Open Book (proto3)',
  description = 'Moving mockup for the getsmartai.ai reset: the Open Book direction.',
} = Astro.props;
// burgundy disc favicon (the site favicon.svg is the retired Green Light mark).
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23FDFBF8'/%3E%3Ccircle cx='16' cy='16' r='9' fill='%236E1F2E'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- add the js flag + optional ?reduce override before first paint (no-FOUC) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('reduce')) d.setAttribute('data-reduce', '');
        } catch (e) {}
      })();
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#FDFBF8" />
    <link rel="preload" href="/fonts/familjen-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zilla-slab-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><style>[data-hero-in], [data-in] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>import '../scripts/proto3.ts';</script>
  </body>
</html>
