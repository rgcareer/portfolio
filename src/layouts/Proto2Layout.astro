---
// Standalone layout for the M-gate "The Highlighter" moving mockup (/proto2).
// Mirrors ProtoLayout: no BaseLayout (that carries dark v3 chrome + motion.ts),
// noindex + unlinked, own head for the Highlighter fonts. This is a gate
// artifact for Ryan's feel-gate, held beside /proto (The Shelf) for comparison.
import '../styles/proto2.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'The Highlighter (proto2)',
  description = 'Moving mockup for the getsmartai.ai revamp: the Highlighter direction.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- add the js flag + optional ?reduce override before first paint (no-FOUC) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // default to the pine ground; the switcher flips it live
        d.setAttribute('data-theme', 'pine');
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('reduce')) d.setAttribute('data-reduce', '');
          if (q.has('theme')) d.setAttribute('data-theme', q.get('theme'));
        } catch (e) {}
      })();
    </script>
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0F3327" />
    <link rel="preload" href="/fonts/syne-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><style>[data-in], [data-hero-in] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <slot />
    <script>import '../scripts/proto2.ts';</script>
  </body>
</html>
