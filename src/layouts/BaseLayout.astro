---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;         // page-specific title (keyword-forward); becomes "<title> · Get Smart AI"
  description?: string;    // page meta description (~155 chars)
  active?: string;         // nav key to highlight
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]; // per-page schema (home: ProfessionalService + FAQ graph)
  ogImage?: string;        // override the default social image
  noindex?: boolean;       // opt a page out of indexing
}
const { title, description, active, jsonLd, ogImage, noindex } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const desc = description ?? site.blurb;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImg = new URL(ogImage ?? '/og.png', site.url).toString();

// Default JSON-LD: the named principal (recruiter surfaces). The home + commercial
// surfaces override this with a ProfessionalService graph (see src/pages/index.astro).
const sameAs = [site.links.linkedin, site.links.github].filter((u) => u && !u.includes('REPLACE'));
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  ...(sameAs.length ? { sameAs } : {}),
};
const ld = jsonLd ?? personLd;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- set the js flag + optional ?reduce override before first paint (no-FOUC; reveal gate) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { if (new URLSearchParams(location.search).has('reduce')) d.setAttribute('data-reduce', ''); } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="US-ID" />
    <meta name="geo.placename" content="Boise" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FDFBF8" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImg} />

    <!-- self-hosted Open Book faces (CSP: no third-party origins; font-src 'self') -->
    <link rel="preload" href="/fonts/familjen-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zilla-slab-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <noscript><style>
      [data-in], [data-hero-in] { opacity: 1 !important; transform: none !important; }
      .line-in { transform: none !important; }
      .daylight { display: none !important; }
    </style></noscript>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar__in">
        <a class="brand" href="/" aria-label={`${site.name}, led by Ryan Garver`}>
          <span class="wm" aria-hidden="true">get smart ai</span>
          <small>led by Ryan Garver · Boise, Idaho</small>
          <span class="sr-only">Get Smart AI, led by Ryan Garver</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav__links">
            {site.nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class:list={['nav__link', { 'is-active': active === n.key }]}
                  aria-current={active === n.key ? 'page' : undefined}
                >{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="topmail" href={`mailto:${site.email}`}>Email Ryan</a>
        <a class="hire" href="/work">Hiring?</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot" aria-label="Footer">
      <div class="wrap">
        <div class="foot__col">
          <span class="wm">get smart ai</span>
          <p class="foot__entity">{site.dba}</p>
          <p class="foot__meta">{site.legalLocation} · © {site.year} Smart Business AI LLC</p>
        </div>
        <div class="foot__col">
          <div class="foot__links">
            <a href="/contact">Contact</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="foot__links">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/accessibility">Accessibility</a>
          </div>
          <div class="foot__links">
            <a href="/work">Hiring? See the work</a>
            <a href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
            {site.links.github && <a href={site.links.github} rel="me noopener" target="_blank">GitHub</a>}
          </div>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
