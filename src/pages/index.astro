---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { offers, offerCopy, dataHandling, kit } from '../config/offers';

// Home = the buyer surface (RELIEF). Redesigned 2026-09-16 into a Start-with-Why arc
// (Why -> How -> What -> proof -> act), reconciled with the charter: the missed-call scene
// IS the compressed Why, told as the customer's problem; the belief + the person move up
// front (the reason to choose us); the "How" (priced accountability) does double duty as the
// proof a skeptical, price-focused buyer needs (Sinek's small-unknown-vendor synthesis).
// Copy is charter-approved (site-copy-drafts.md); no category contrast; every number real or
// absent; no em/en dashes. Motion is the existing calm system (daylight/reveals/tally),
// motivated by the narrative, reduced-motion + no-JS safe.

// FAQ is visible-only now (Google retired FAQ rich results 2026-05). Trimmed to the four not
// already answered by the substitute answers below.
const faqs = [
  {
    q: 'How much does this cost?',
    a: 'Every price is on this page. The diagnostic is a flat $750. Automation builds start at $2,000, team training at $900, and the full enablement program at $2,500, all fixed in writing after the diagnostic scopes the work. Keeping it running is $0 a month, because you own it. There is a $199 starter kit under the rate card, and websites have their own page. Nothing is hidden behind a call.',
  },
  {
    q: 'Do I need to understand AI to work with you?',
    a: 'No. My whole job is to make AI make sense and make money for people who do not care how it works. I speak plain English and I put the numbers where you can see them.',
  },
  {
    q: 'What happens if you are not available later?',
    a: 'The code and logins live in your accounts, you get a written handoff, and there is a named backup. It costs $0 a month to keep running because you own it. No lock-in.',
  },
  {
    q: 'Which businesses do you work with?',
    a: 'Small businesses that run without an engineering department, in and around Boise and remote: trades, dental and medical practices, restaurants, retail, and professional services.',
  },
];

// The How = priced accountability, shown as three principles. For a small unknown vendor the
// How layer is also the proof (a named process, a mechanical guarantee, a real price).
const principles = [
  {
    k: 'Diagnose first',
    v: 'We start with a $750 diagnostic: your own numbers, counted with you, plus one working automation on the tools you already pay for, delivered on a set date. Decide inside 30 days it was not worth it and the invoice is voided. Sign a build within 90 days and the $750 comes off it.',
  },
  {
    k: 'Every price in plain sight',
    v: 'The whole menu is on this page. Fixed fees, scoped in writing after the diagnostic. No hourly meter, no retainer required, and no number you have to book a call to hear.',
  },
  {
    k: 'You own what I build',
    v: 'Code, logins, and documents live in your accounts. $0 a month to keep it running, a written handoff, and a named backup, so it never depends on one person being reachable in October.',
  },
];

// One @graph: the business entity (LocalBusiness - ProfessionalService is deprecated on
// schema.org "due to confusion with Service") + the named principal as a linked Person.
// SAB: locality-only address + areaServed, no telephone. Fixed prices use bare `price`;
// "starting at" prices use UnitPriceSpecification.minPrice (never both on one Offer).
// NOTE: no FAQPage node - Google removed FAQ rich results for all sites (2026-05); the
// visible FAQ below stays for readers, but the schema wrapper is dead weight now.
const sameAs = [site.links.linkedin, site.links.github].filter(Boolean);
const fixed = (name: string, price: number) => ({ '@type': 'Offer', name, price, priceCurrency: 'USD' });
const from = (name: string, min: number) => ({
  '@type': 'Offer',
  name,
  priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: min, priceCurrency: 'USD' },
});
const homeLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${site.url}/#business`,
      name: site.brand,
      alternateName: 'Get Smart AI, led by Ryan Garver',
      legalName: site.legalEntity,
      description:
        'AI consulting, automation builds, team training, and websites for small businesses without an engineering department. Published prices, a named principal, and a diagnostic that is free if it is not worth the fee.',
      url: site.url,
      image: new URL('/og.png', site.url).toString(),
      priceRange: '$199-$2,500',
      address: { '@type': 'PostalAddress', addressLocality: 'Boise', addressRegion: 'ID', addressCountry: 'US' },
      areaServed: [
        { '@type': 'City', name: 'Boise' },
        { '@type': 'AdministrativeArea', name: 'Treasure Valley' },
        { '@type': 'Country', name: 'United States' },
      ],
      founder: { '@id': `${site.url}/#ryan-garver` },
      knowsAbout: ['AI automation', 'AI consulting', 'business process automation', 'AI adoption', 'small business AI'],
      sameAs,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services and prices',
        itemListElement: [
          fixed('AI diagnostic', 750),
          from('Automation build', 2000),
          from('Team training', 900),
          from('Enablement program', 2500),
          from('Website', 1500),
          fixed('Contractor AI Follow-Up Revenue Kit', 199),
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#ryan-garver`,
      name: site.name,
      jobTitle: site.role,
      url: site.url,
      worksFor: { '@id': `${site.url}/#business` },
      sameAs,
    },
  ],
};

const title = 'AI Automation & Consulting for Small Business, Boise';
const description =
  'Practical AI for Boise small businesses without an engineering department: automation, consulting, training, and websites. Published prices, a real named principal, and a diagnostic that is free if it is not worth the fee.';
---
<BaseLayout title={title} description={description} active="home" jsonLd={homeLd}>
  <!-- Daylight Journey (home only): a continuous warm light behind the page that drifts as
       you scroll, a daylight progress thread, and a chapter rail for wayfinding. All are
       decorative or supplementary and degrade to the calm static page under reduced-motion,
       no-JS, or no scroll-timeline support. -->
  <div class="sky" aria-hidden="true"><canvas class="daylight" aria-hidden="true"></canvas></div>
  <div class="thread" aria-hidden="true"><span class="thread__fill"></span></div>
  <nav class="rail" aria-label="Sections on this page">
    <a class="rail__item" href="#why" data-rail><span class="rail__label">Why</span><span class="rail__dot" aria-hidden="true"></span></a>
    <a class="rail__item" href="#how" data-rail><span class="rail__label">How</span><span class="rail__dot" aria-hidden="true"></span></a>
    <a class="rail__item" href="#proof" data-rail><span class="rail__label">Proof</span><span class="rail__dot" aria-hidden="true"></span></a>
    <a class="rail__item" href="#rates" data-rail><span class="rail__label">Rates</span><span class="rail__dot" aria-hidden="true"></span></a>
    <a class="rail__item" href="#start" data-rail><span class="rail__label">Start</span><span class="rail__dot" aria-hidden="true"></span></a>
  </nav>

  <!-- 1. HERO: the missed-call scene = the compressed Why, told as the customer's problem -->
  <div class="hero">
    <div class="sun-patch" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow" data-hero-step style="--step: 0">Get Smart AI · Boise and the Treasure Valley · led by <b>Ryan Garver</b></p>
      <h1>
        <span class="line"><span class="line-in" style="--line-step: 1">The call you miss at 6:40</span></span>
        <span class="line"><span class="line-in" style="--line-step: 2">is a job gone by 6:41.</span></span>
      </h1>
      <p class="hero-sub" data-hero-step style="--step: 3">A call comes in while you are on a roof. Nobody answers, and that customer calls the next company on the list. I build the system that catches the call and follows up, so the job does not walk.</p>
      <div class="cta-row" data-hero-step style="--step: 4">
        <a class="btn" href="#start" data-magnetic>Start with a diagnostic <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="link-arrow" href="#how">See how it works <span class="a" aria-hidden="true">&rarr;</span></a>
      </div>
      <p class="hero-certainty" data-hero-step style="--step: 5">You will know by a set date what it costs to fix.</p>
    </div>
  </div>

  <!-- 2. THE GUIDE + THE WHY: the belief and the person, up front (the reason to choose us) -->
  <section class="guide" id="why" aria-labelledby="why-h">
    <div class="wrap">
      <p class="kicker" data-in>Why I do this</p>
      <p class="guide__belief" data-in>I spent twenty years getting big companies onto new tools. I started this to do the same for the business down the street.</p>
      <div class="guide__body">
        <p data-in>I am Ryan Garver. For twenty years I helped teams adopt new technology, here in the Treasure Valley, at Apple, Intuit, Cradlepoint, and Vacasa. At Apple I got organizations like St. Luke's and Dutch Bros onto new tools. The job, every time, was making technology make sense to people who do not care how it works.</p>
        <p data-in>The belief behind Get Smart AI is simple: the shop down the street deserves the same competent, measured help those big companies got, without an engineering department and without a leap of faith about what it costs. You are the expert on your business. I build the system, put the price in plain sight, and stand behind the number.</p>
        <p class="guide__sig" data-in>Ryan Garver · Get Smart AI · Boise, Idaho</p>
      </div>
    </div>
  </section>

  <!-- 3. HOW I WORK: priced accountability, three principles (the How that is also the proof) -->
  <section class="how sec-blush" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <p class="kicker" data-in>How I work</p>
      <h2 class="sec-title" id="how-h" data-in>Three promises, before you spend a dollar.</h2>
      <ol class="principles" data-in>
        {principles.map((p, i) => (
          <li class="principle">
            <span class="principle__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="principle__text">
              <h3 class="principle__k">{p.k}</h3>
              <p class="principle__v">{p.v}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="notice" data-in><b>Your data stays yours.</b> {dataHandling}</p>
    </div>
  </section>

  <!-- 4. PROOF: moved up (a skeptical buyer needs proof next to the belief), the burgundy band -->
  <section class="proof" id="proof" aria-labelledby="proof-h">
    <div class="wrap">
      <p class="kicker" data-in>The proof</p>
      <h2 class="sec-title" id="proof-h" data-in>I measure my own work. You can check it.</h2>
      <p class="sec-intro" data-in>I run a system in real production and keep the receipts. Here is how it holds up, ranked the way it actually matters, and I will hold your business to the same standard.</p>

      <div class="totals" data-in>
        <div class="total">
          <div class="total-figure" data-count="0">0</div>
          <p class="total-label">re-score errors on the audited pass</p>
          <p class="total-bridge">Run it twice, get the same answer twice. That is the standard I hold my own system to, and the one I will hold yours to.</p>
        </div>
        <div class="total">
          <div class="total-figure" data-count="616">616</div>
          <p class="total-label">tests keeping the scoring honest</p>
          <p class="total-bridge">Before it touches real work, 616 separate checks have to pass. Your phone system gets the same discipline.</p>
        </div>
        <div class="total">
          <div class="total-figure" data-count="0" data-prefix="$">$0</div>
          <p class="total-label">extra cost to score one more</p>
          <p class="total-bridge">The ten-thousandth one costs the same as the first: nothing extra.</p>
        </div>
      </div>

      <p class="scope-context" data-in>That same system, Operation Hired, has scored <span class="num">14,851</span> job postings in total, each one reproducible from its source.</p>
      <p class="thesis-line" data-in>The point is not the size of the number. It is that <b>you can open the file and check it.</b></p>

      <div class="case-line" data-in>
        <p><strong>Operation Hired.</strong> Real production I designed, built, and ran myself, with real load and kept receipts. I will measure your business the same way.</p>
        <a class="link-arrow" href="/work/operation-hired/method">Method and results, open the file <span class="a" aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="slot-empty" data-in>
        Local client work is not published here yet. When it is, it will be a named business in your trade with real before and after numbers, not a logo wall. Until then, the system above is the receipt I can show you.
      </div>
    </div>
  </section>

  <!-- 5. WHAT IT COSTS: now that trust is built. Your number (estimator), then the menu -->
  <section id="estimate" aria-labelledby="estimate-h">
    <div class="wrap">
      <p class="kicker" data-in>Your number</p>
      <h2 class="sec-title" id="estimate-h" data-in>What is a missed call actually costing you?</h2>
      <div class="estimator" data-estimator data-in>
        <p class="est-lead">Use your own numbers.</p>
        <p class="est-static" data-est-static>
          A worked example: miss 10 calls a week, an average job is worth $400, and you win 3 of every 10 good leads. That is about <b>$5,200 a month</b> walking to whoever answers first. Turn on scripts to run your own numbers.
        </p>
        <div class="est-live" data-est-live hidden>
          <div class="est-inputs">
            <div class="est-field">
              <label for="est-calls">Missed calls in a typical week</label>
              <input id="est-calls" type="number" inputmode="numeric" min="0" step="1" value="10" />
            </div>
            <div class="est-field">
              <label for="est-value">What an average job is worth to you</label>
              <input id="est-value" type="number" inputmode="numeric" min="0" step="50" value="400" />
            </div>
            <div class="est-field">
              <label for="est-real">Jobs you win out of ten good leads</label>
              <input id="est-real" type="number" inputmode="numeric" min="0" max="10" step="1" value="3" />
            </div>
          </div>
          <div class="est-out">
            <span class="est-figure" data-est-out aria-live="polite">$5,200</span>
            <span class="est-caption">a month, walking to whoever picks up first. Your numbers, multiplied. Nothing here is my estimate. Illustrative only; your results will vary.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="rates" class="sec-blush" aria-labelledby="rates-h">
    <div class="wrap">
      <p class="kicker" data-in>The rate card</p>
      <h2 class="sec-title" id="rates-h" data-in>What it costs, in plain sight</h2>
      <p class="sec-intro" data-in>Published rates, the way your accountant would insist on. Start with the diagnostic. Everything after it is scoped from what it finds.</p>

      <div class="ledger" data-in>
        {offers.map((o) => (
          <div class:list={['line-item', { 'is-start': o.startHere, 'is-flagship': o.flagship }]}>
            {o.startHere && <span class="li-flag">Start here</span>}
            {o.flagship && <span class="li-flag">The full program</span>}
            <div class="li-row">
              <span class="li-name">{o.name}</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="li-price">{o.startingAt && <small>Starting at</small>}{o.priceLabel}</span>
            </div>
            <p class="li-sub">{o.mechanism}</p>
            {o.startHere && (
              <>
                <p class="li-guarantee">{offerCopy.guaranteeFull}</p>
                <p class="li-sample">{offerCopy.sampleLine}</p>
              </>
            )}
          </div>
        ))}
      </div>
      <p class="ledger-basis" data-in>{offerCopy.pricingBasis}</p>
      <p class="ledger-basis" data-in>{offerCopy.floorsLow}</p>
      <p class="ledger-note" data-in>{kit.line}</p>
    </div>
  </section>

  <!-- 6. STRAIGHT ANSWERS: the cheaper options + the questions, consolidated -->
  <section id="answers" aria-labelledby="answers-h">
    <div class="wrap">
      <p class="kicker" data-in>The cheaper options, honestly</p>
      <h2 class="sec-title" id="answers-h" data-in>What the quick fixes leave you holding</h2>
      <div class="subs" data-in>
        <div class="panel">
          <h3>A chatbot</h3>
          <p>A chatbot can draft the follow-up text. It cannot notice the missed call and send it. That trigger is the whole job.</p>
        </div>
        <div class="panel">
          <h3>A freelancer gig</h3>
          <p>A freelancer builds the automation you already know you want. The diagnostic is for the owner who does not yet know which fix comes first.</p>
        </div>
        <div class="panel">
          <h3>An answering service</h3>
          <p>An answering service answers the phone. It does not fix what happens after: the quote that goes cold, the follow-up nobody sends.</p>
        </div>
      </div>

      <div class="faqs" data-in>
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. ACT: the close -->
  <section class="close-cta sec-blush" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <p class="kicker" data-in>The next line item</p>
      <h2 class="sec-title" id="start-h" data-in>Tell me what is slow.</h2>
      <p class="close-sub" data-in>I will tell you what it costs to fix. Three fields, no sales call. You decide if the diagnostic was worth it; if not, the invoice is voided.</p>

      <form class="form" name="intake" data-intake data-in>
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
          <span class="err" role="alert">Add your name so I know who I am talking to.</span>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
          <span class="err" role="alert">Add an email I can reply to.</span>
        </div>
        <div class="field">
          <label for="f-slow">What is slow, in one line?</label>
          <input id="f-slow" name="slow" type="text" maxlength="160" />
        </div>
        <div class="form-actions">
          <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent('What is slow in my business')}`} data-intake-submit data-magnetic>Start the conversation <span class="chip-arrow" aria-hidden="true">&rarr;</span></a>
          <span class="form-note">Goes straight to me. No list, no sales sequence.</span>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-certainty { margin-top: 16px; font-size: var(--fs-small); color: var(--muted); }

  /* 2. Guide + Why: a warm, spacious break from the ledger rhythm. The belief is the one
     large pull-quote on the page; the body sits in a narrow, readable measure. */
  .guide .wrap { max-width: 900px; }
  .guide__belief {
    font-family: var(--font-slab); font-weight: 600; letter-spacing: -0.015em; line-height: 1.14;
    font-size: clamp(1.7rem, 3.8vw, 2.9rem); color: var(--ink); margin-top: 0.9rem; max-width: 22ch;
    text-wrap: balance;
  }
  .guide__belief::first-line { color: var(--burgundy); }
  .guide__body { margin-top: clamp(1.8rem, 4vw, 2.6rem); max-width: 60ch; display: grid; gap: 1.2rem; }
  .guide__body p { font-size: var(--fs-body); line-height: 1.7; color: var(--ink-2); }
  .guide__sig { font-family: var(--font-slab); font-weight: 600; font-size: var(--fs-small); color: var(--burgundy); letter-spacing: 0.02em; }

  /* 3. How: three numbered principles. Distinct layout (index numeral + text), not cards. */
  .principles { list-style: none; margin: clamp(1.8rem, 4vw, 2.6rem) 0 0; padding: 0; display: grid; gap: 0; counter-reset: none; }
  .principle {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem 1.6rem; align-items: start;
    padding: clamp(1.4rem, 3vw, 2rem) 0; border-top: 1px solid var(--hairline);
  }
  .principle:last-child { border-bottom: 1px solid var(--hairline); }
  .principle__n {
    font-family: var(--font-slab); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--burgundy); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .principle__k { font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 700; letter-spacing: -0.01em; }
  .principle__v { margin-top: 0.55rem; font-size: var(--fs-body); line-height: 1.65; color: var(--ink-2); max-width: 62ch; }
  .how .notice { margin-top: clamp(1.8rem, 4vw, 2.4rem); }
  @media (min-width: 780px) {
    .principle { grid-template-columns: 3.4rem minmax(0, 1fr); }
  }

  .line-item.is-flagship { border-top: 2px solid var(--burgundy); }

  /* estimator gets a touch more room now that it lands after the trust build */
  #estimate .estimator { margin-top: clamp(1.4rem, 3vw, 2rem); }

  .subs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 40px; margin-top: 30px; }
  @media (max-width: 800px) { .subs { grid-template-columns: 1fr; } }

  .faqs { margin-top: clamp(2.4rem, 5vw, 3.4rem); border-top: 2px solid var(--ink); padding-top: 0.5rem; }
  .faq { border-top: 1px solid var(--hairline); padding: 4px 0; }
  .faq:first-child { border-top: none; }
  .faq:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { list-style: none; cursor: pointer; padding: 16px 28px 16px 0; font-weight: 600; font-size: 17px; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 2px; top: 14px; font-family: var(--font-slab); font-size: 22px; color: var(--burgundy); line-height: 1; }
  .faq[open] summary::after { content: '\2212'; }
  .faq p { padding: 0 0 18px; color: var(--ink-2); max-width: 64ch; }

  /* ---- Daylight Journey: through-line light + progress thread + chapter rail ----
     Content sits above the sky; transparent sections let it glow through, blush is
     translucent so it tints, the burgundy proof band stays solid (the sun behind it). */
  .hero, section { position: relative; z-index: 1; }
  .sec-blush { background: color-mix(in srgb, var(--blush) 88%, transparent); }

  .sky {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.85;
    background: radial-gradient(115% 75% at 78% -8%, color-mix(in srgb, var(--sun) 60%, transparent) 0%, transparent 55%);
  }
  .sky .daylight { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* CSS gradient drift = the fallback when WebGL is absent but scroll-timeline exists.
     :not(.gl) so it never fights the live canvas (which must not be transform-drifted). */
  @media (prefers-reduced-motion: no-preference) and (pointer: fine) {
    html.js:not([data-reduce]):not(.gl) .sky { will-change: transform, opacity; animation: sky-drift linear both; animation-timeline: scroll(root); }
  }
  @keyframes sky-drift {
    from { transform: translate3d(0, -3vh, 0); opacity: 0.95; }
    to   { transform: translate3d(-5vw, 20vh, 0); opacity: 0.55; }
  }
  /* WebGL success (motion.ts adds html.gl): the canvas IS the living daylight ground. */
  html.gl .sky { opacity: 1; background: var(--ground); }

  .thread { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: calc(var(--z-nav) + 1); pointer-events: none; }
  .thread__fill { display: block; height: 100%; transform-origin: left center; transform: scaleX(0); background: linear-gradient(90deg, var(--amber, #E8A54D), var(--burgundy)); }
  html.js:not([data-reduce]) .thread__fill { animation: thread-grow linear both; animation-timeline: scroll(root); }
  @keyframes thread-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @supports not (animation-timeline: scroll()) { .thread { display: none; } }

  /* chapter rail: desktop wayfinding. Real anchor links; active state from motion.ts (IO). */
  .rail { display: none; }
  @media (min-width: 1180px) {
    .rail { position: fixed; right: 20px; top: 50%; transform: translateY(-50%); z-index: var(--z-nav); display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
