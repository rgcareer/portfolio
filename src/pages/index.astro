---
// The real HOME, Overvolt x Aurora (accent: Ember). Flat and solid: deep cool-ink
// ground, ONE warm-gold accent (underlines, CTA, evidence numbers), billboard type,
// sharp motion, NO gradients. Five beats: billboard hero -> services teaser
// (published prices) -> proof (gold evidence numbers) -> annotated casebook -> inline
// intake close. Numbers live INSIDE sentences. No em/en dashes. Casebook pulls the
// flagship from work.ts (single source). Intake is styled markup ONLY (Worker = later).
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getCase } from '../config/work';

const casebook = getCase('should-i-automate-this')!;

const services = [
  { name: 'AI consulting', what: 'Find the', mark: 'follow-up leaks', tail: ' that cost you jobs.', price: 'from $750' },
  { name: 'Automation builds', what: 'Hand the repetitive work to', mark: 'something tireless', tail: '.', price: 'from $2,000' },
  { name: 'Website design', what: 'A site that', mark: 'earns its keep', tail: ', live in two weeks.', price: 'from $1,500' },
  { name: 'Team training', what: 'Your team,', mark: 'fluent in the tools', tail: ' they already pay for.', price: 'from $900' },
  { name: 'AI kits', what: 'The follow-up system,', mark: 'boxed and done for you', tail: '.', price: '$199' },
];

const homeDesc = 'AI that pays for itself, in plain English. Get Smart AI, led by Ryan Garver: AI consulting, automation, websites, and team training. Boise and remote.';

const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Get Smart AI',
  legalName: site.legalEntity,
  description: 'AI enablement and adoption for small businesses: consulting, automation builds, website design, and team training.',
  url: site.url,
  email: `mailto:${site.email}`,
  areaServed: 'Boise, Idaho and remote',
  founder: { '@type': 'Person', name: site.name },
  sameAs: [site.links.linkedin, site.links.github],
};
---
<BaseLayout description={homeDesc} jsonLd={businessLd}>
  <!-- THE CIRCUIT: one gold current drawn down the page by scroll -->
  <div class="circuit" aria-hidden="true"><span class="spine"></span></div>

  <!-- BEAT 1: billboard hero -->
  <section class="wrap hero" aria-label="Introduction">
    <p class="eyebrow" data-hero-in>AI enablement · Boise &amp; remote</p>
    <div class="head-clip">
      <h1 class="head">
        AI that <span class="zap" data-charge>pays for itself</span>, in <span class="zap" data-charge>plain English</span><span class="disc-dot" aria-hidden="true"></span>
      </h1>
    </div>
    <p class="lead" data-hero-in style="--in-delay: 150ms">
      I build it, I teach it, and I can show you every number behind it. No jargon, no hand-waving.
    </p>
    <div class="cta-row" data-hero-in style="--in-delay: 230ms">
      <a class="btn" href="#close">Start a plain-English audit <span class="btn__arrow">&rarr;</span></a>
      <a class="link-quiet" href="#casebook">See the work</a>
    </div>
  </section>

  <!-- BEAT 2: services teaser -->
  <section class="wrap section band-2" id="services" aria-labelledby="svc-h">
    <div class="svc-head">
      <h2 id="svc-h" data-in>Pick the format. The <span class="gw">promise stays the same</span>.</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <div class="svc" data-in style={`--in-delay: ${i * 55}ms`}>
          <div class="svc__name">{s.name}</div>
          <div class="svc__what">{s.what} <span class="gw">{s.mark}</span>{s.tail}</div>
          <div class="svc__price">{s.price}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- BEAT 3: proof (evidence numbers in gold, on the dark ground) -->
  <section class="wrap section proof" aria-label="Proof">
    <p class="proof__claim" data-in>
      I built a scorer that read <span class="num surge" data-count="14851">14,851</span> job postings, checked each against its source, and made <span class="num">zero</span> re-score errors.
    </p>
    <p class="proof__attrib" data-in style="--in-delay: 120ms">Operation Hired, a tool I built. 616 tests passing.</p>
  </section>

  <!-- BEAT 4: annotated casebook spread -->
  <section class="wrap section band-2" id="casebook" aria-labelledby="case-h">
    <div class="case">
      <div class="case__body">
        <p class="case__kick" data-in>Case · {casebook.role} · {casebook.year}</p>
        <h2 class="case__title" id="case-h" data-in style="--in-delay: 50ms">{casebook.title}</h2>
        <p class="case__lead" data-in style="--in-delay: 110ms">
          It ships with <span class="num">28 of 28</span> tests passing and <span class="num">10 of 10</span> calibration goldens, and it answers one question: should a model touch this task at all?
        </p>
        <div class="case__ba">
          <div class="ba__row" data-in>
            <div class="ba__tag">The default way</div>
            <div class="ba__txt">{casebook.flip?.before}</div>
          </div>
          <div class="ba__row" data-in style="--in-delay: 70ms">
            <div class="ba__tag is-built">The built way</div>
            <div class="ba__txt is-built">{casebook.flip?.after}</div>
          </div>
        </div>
        <p class="verdict" data-in style="--in-delay: 60ms">
          It talks you out of the <span class="gw">wrong ones first</span>.
        </p>
        <a class="link-green case__more" href="/work/should-i-automate-this" data-in>Read the case</a>
      </div>
      <figure class="case__fig" data-in style="--in-delay: 120ms">
        <div class="frame">
          <img src={casebook.figure.src} alt={casebook.figure.alt} width={casebook.figure.width} height={casebook.figure.height} loading="lazy" />
        </div>
        <figcaption>The verdict screen: a tier and a concrete stop-test, not a hype score.</figcaption>
      </figure>
    </div>
  </section>

  <!-- BEAT 5: intake close (markup only; Worker POST wired later) -->
  <section class="close" id="close" aria-labelledby="close-h">
    <div class="wrap section">
      <h2 id="close-h" data-in>Tell me what is slow. I will tell you if <span class="gw">AI actually fixes it</span>.</h2>
      <p class="sub" data-in style="--in-delay: 70ms">
        No sales call. A short note, and a straight answer about whether this is worth your money.
      </p>
      <form class="intake" data-in style="--in-delay: 140ms" aria-label="Start a conversation">
        <input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="Your name" />
        <input type="email" name="email" placeholder="Email" autocomplete="email" aria-label="Email" />
        <button class="btn" type="button">Start the conversation <span class="btn__arrow">&rarr;</span></button>
      </form>
      <p class="fine" data-in style="--in-delay: 200ms">Prefer email? <a href={`mailto:${site.email}`}>Write me directly.</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* BEAT 1 billboard hero */
  .hero { min-height: 88svh; display: flex; flex-direction: column; justify-content: center; padding-block: var(--space-16) var(--space-24); }
  .hero .head-clip { margin-block: var(--space-6) 0; }
  .hero .head { font-family: var(--display); font-weight: 800; font-size: var(--fs-display); line-height: 1.02; letter-spacing: -0.035em; max-width: 16ch; }
  .hero .lead { font-family: var(--sans); font-weight: 300; font-size: var(--fs-lead); color: var(--ink-soft); max-width: 46ch; margin-top: var(--space-8); line-height: 1.55; }
  .hero .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); align-items: center; margin-top: var(--space-12); }

  /* alternate solid section ground (subtle rhythm, no gradient) */
  .band-2 { background: var(--ground-2); }

  /* BEAT 2 services */
  .svc-head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-16); }
  .svc-head h2 { font-family: var(--display); font-size: var(--fs-h1); font-weight: 700; max-width: 20ch; letter-spacing: -0.03em; }
  .svc-list { border-top: 1px solid var(--line); }
  .svc { display: grid; grid-template-columns: minmax(9rem, 15rem) 1fr auto; gap: var(--space-4) var(--space-8); align-items: baseline; padding-block: var(--space-8); border-bottom: 1px solid var(--line); }
  .svc__name { font-family: var(--display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }
  .svc__what { font-size: 1.1rem; color: var(--ink-soft); }
  .svc__price { font-family: var(--sans); font-weight: 600; font-size: 1.02rem; color: var(--ink); white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* BEAT 3 proof */
  .proof { text-align: left; }
  .proof__claim { font-family: var(--sans); font-weight: 500; font-size: clamp(1.5rem, 3.6vw, 2.7rem); line-height: 1.28; max-width: 24ch; margin-top: 0; color: var(--ink); letter-spacing: -0.01em; }
  .proof__claim .num { font-size: 1.18em; font-weight: 700; }
  /* the surge: the evidence number recomposed at display scale, its own line inside the sentence */
  .surge { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(3.4rem, 13vw, 9rem); line-height: 0.9; letter-spacing: -0.04em; color: var(--gold); margin: 0.04em 0; font-variant-numeric: tabular-nums; }
  .proof__attrib { font-family: var(--sans); font-size: var(--fs-small); color: var(--ink-muted); margin-top: var(--space-8); letter-spacing: 0.02em; }

  /* BEAT 4 casebook spread */
  .case { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(var(--space-8), 5vw, var(--space-24)); align-items: start; }
  .case__kick { font-family: var(--sans); font-size: var(--fs-small); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .case__title { font-family: var(--display); font-size: var(--fs-h1); font-weight: 700; margin-top: var(--space-3); letter-spacing: -0.03em; }
  .case__lead { font-size: var(--fs-lead); color: var(--ink-soft); margin-top: var(--space-6); line-height: 1.5; }
  .case__ba { display: grid; gap: var(--space-6); margin-top: var(--space-12); }
  .ba__row { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: baseline; }
  .ba__tag { font-family: var(--sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; padding-top: 0.25em; }
  .ba__tag.is-built { color: var(--gold); }
  .ba__txt { font-size: 1.08rem; color: var(--ink-soft); }
  .ba__txt.is-built { color: var(--ink); }
  .verdict { font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 700; line-height: 1.18; margin-top: var(--space-12); max-width: 22ch; letter-spacing: -0.03em; }
  .case__more { margin-top: var(--space-8); display: inline-block; }
  .case__fig { margin: 0; margin-top: -2.5rem; }
  .case__fig .frame { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--space-3); overflow: hidden; box-shadow: 0 24px 60px -30px rgba(0,0,0,.7); }
  .case__fig img { border-radius: 6px; width: 100%; height: auto; }
  .case__fig figcaption { font-family: var(--sans); font-size: 0.82rem; color: var(--ink-muted); margin-top: var(--space-3); }

  /* BEAT 5 intake close */
  .close { background: var(--ground-2); }
  .close h2 { font-family: var(--display); font-size: var(--fs-h1); font-weight: 700; max-width: 18ch; letter-spacing: -0.03em; }
  .close .sub { font-size: var(--fs-lead); color: var(--ink-soft); margin-top: var(--space-6); max-width: 42ch; }
  .intake { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-12); max-width: 34rem; }
  .intake input { flex: 1 1 15rem; min-width: 0; font: inherit; font-size: 1.02rem; padding: 0.9em 1.1em; border: 1.5px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--ink); }
  .intake input::placeholder { color: var(--ink-muted); }
  .intake input:focus-visible { border-color: var(--gold); outline: none; }
  .intake .btn { flex: 0 0 auto; }
  .close .fine { font-family: var(--sans); font-size: var(--fs-small); color: var(--ink-muted); margin-top: var(--space-6); }
  .close .fine a { color: var(--gold-bright); }

  /* ---- THE CIRCUIT: gold current drawn down the page by scroll ---- */
  .circuit { position: absolute; inset: 0; margin-inline: auto; max-width: var(--container); padding-inline: var(--gutter); pointer-events: none; z-index: 5; }
  .spine { position: absolute; top: 0; left: calc(var(--gutter) - 0.9rem); width: 2px; height: 100%; background: var(--gold); transform: scaleY(1); transform-origin: top center; }
  :global(.js) .spine { transform: scaleY(0); }
  /* service-row taps: short gold ticks that draw as the current reaches each row */
  .svc { position: relative; }
  .svc::before { content: ""; position: absolute; left: -0.9rem; top: 2rem; width: 0.9rem; height: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left center; }
  :global(.js) .svc.is-in::before { transform: scaleX(1); transition: transform 0.5s var(--ease-sweep); }
  /* disc-as-period: the headline ends with the gold light, like the wordmark */
  .disc-dot { display: inline-block; width: 0.3em; height: 0.3em; border-radius: 50%; background: var(--gold); margin-left: 0.05em; vertical-align: baseline; }
  /* terminal power-on: the CTA pops when the current completes */
  @keyframes cta-live { 0% { transform: scale(1); filter: brightness(1); } 35% { transform: scale(1.05); filter: brightness(1.2); } 100% { transform: scale(1); filter: brightness(1); } }
  :global(.js) .close .btn.is-live { animation: cta-live 0.7s var(--ease-out) 1; }

  @media (max-width: 820px) {
    .case { grid-template-columns: 1fr; }
    .case__fig { order: -1; max-width: 24rem; margin-top: 0; }
    .svc { grid-template-columns: 1fr auto; }
    .svc__what { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) { .circuit, .svc::before { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .spine { transform: scaleY(1); }
    :global(.js) .svc.is-in::before { transform: scaleX(1); transition: none; }
    :global(.js) .close .btn.is-live { animation: none; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 82svh; }
    .svc { grid-template-columns: 1fr; gap: var(--space-2); }
    .svc__price { justify-self: start; }
    .intake input { flex-basis: 100%; }
    .intake .btn { width: 100%; justify-content: center; }
  }
</style>
